@page "/categorias"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject CategoriaService CategoriaSvc
@inject ISnackbar Snackbar
@using XpressMarket.Shared.Models

<PageTitle>XpressMarket - Categorías</PageTitle>

<div class="pa-4 pa-md-6">
    @* Banner Principal *@
    <MudPaper Elevation="0" Class="pa-6 mb-6 rounded-xl d-flex justify-between align-center" 
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div>
            <div class="d-flex align-center gap-2 mb-2">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;" Class="fw-bold">
                    Catálogo Base
                </MudChip>
            </div>
            <MudText Typo="Typo.h4" Class="fw-bold mb-1" Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2);">
                Gestión de Categorías
            </MudText>
            <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                Organiza y clasifica los productos de tu inventario.
            </MudText>
        </div>
        <div class="d-none d-md-block">
            <MudIcon Icon="@Icons.Material.Filled.Category" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
        </div>
    </MudPaper>

    @* Contenedor Principal *@
    <MudPaper Elevation="2" Class="pa-5 rounded-xl" Style="background: #ffffff; border: 1px solid #e0e0e0;">
        <div class="d-flex justify-between align-center mb-4">
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">
                Listado de Categorías
            </MudText>
            <MudButton Variant="Variant.Filled" 
                       Style="background-color: #6b2181; color: #ffffff; font-weight: bold;" 
                       StartIcon="@Icons.Material.Filled.Add" 
                       OnClick="AbrirFormularioNuevo" 
                       Class="rounded-lg">
                Nueva Categoría
            </MudButton>
        </div>

        @if (cargando)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (categorias == null || !categorias.Any())
        {
            <MudText Typo="Typo.body2" Class="text-muted italic pa-4">No hay categorías registradas.</MudText>
        }
        else
        {
            <MudTable Items="@categorias" Dense="true" Hover="true" Elevation="0" Class="rounded-lg">
                <HeaderContent>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Style="text-align: right;">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nombre">
                        <strong Style="color: #4a1458;">@context.Nombre</strong>
                    </MudTd>
                    <MudTd DataLabel="Descripción">
                        <span Style="color: #6c757d;">@(string.IsNullOrWhiteSpace(context.Descripcion) ? "Sin descripción" : context.Descripcion)</span>
                    </MudTd>
                    <MudTd DataLabel="Acciones" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Color="Color.Info" 
                                       Size="Size.Small" 
                                       OnClick="() => AbrirFormularioEditar(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small" 
                                       OnClick="() => EliminarCategoria(context.Id)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</div>

@* Diálogo Formulario Modal *@
<MudDialog @bind-IsVisible="mostrarFormulario" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #6b2181;">
            <MudIcon Icon="@(categoriaEditando.Id == 0 ? Icons.Material.Filled.AddCircle : Icons.Material.Filled.Edit)" Class="mr-2" />
            @(categoriaEditando.Id == 0 ? "Nueva Categoría" : "Editar Categoría")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="categoriaEditando" OnValidSubmit="GuardarCategoria">
            <DataAnnotationsValidator />

            <MudTextField Label="Nombre" 
                          @bind-Value="categoriaEditando.Nombre" 
                          For="@(() => categoriaEditando.Nombre)" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" 
                          Class="mb-4" />

            <MudTextField Label="Descripción" 
                          @bind-Value="categoriaEditando.Descripcion" 
                          For="@(() => categoriaEditando.Descripcion)" 
                          Variant="Variant.Outlined" 
                          Lines="3" 
                          Margin="Margin.Dense" 
                          Class="mb-2" />

            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="CerrarFormulario" Variant="Variant.Outlined" Color="Color.Secondary">
                    Cancelar
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Style="background-color: #6b2181; color: #ffffff;">
                    Guardar
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    private List<Categoria>? categorias;
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private Categoria categoriaEditando = new();

    private DialogOptions dialogOptions = new DialogOptions 
    { 
        CloseButton = true, 
        MaxWidth = MaxWidth.Small, 
        FullWidth = true, 
        BackdropClick = false,
        CloseOnEscapeKey = false
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            categorias = await CategoriaSvc.ObtenerTodasAsync();
        }
        catch
        {
            // Manejo seguro
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirFormularioNuevo()
    {
        categoriaEditando = new Categoria { Activo = true };
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(Categoria categoria)
    {
        categoriaEditando = new Categoria
        {
            Id = categoria.Id,
            Nombre = categoria.Nombre,
            Descripcion = categoria.Descripcion,
            Activo = categoria.Activo
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarCategoria()
    {
        if (categoriaEditando.Id == 0)
        {
            await CategoriaSvc.CrearAsync(categoriaEditando);
            Snackbar.Add("Categoría creada con éxito", Severity.Success);
        }
        else
        {
            await CategoriaSvc.ActualizarAsync(categoriaEditando.Id, categoriaEditando);
            Snackbar.Add("Categoría actualizada con éxito", Severity.Success);
        }

        mostrarFormulario = false;
        await CargarDatos();
    }

    private async Task EliminarCategoria(int id)
    {
        await CategoriaSvc.EliminarAsync(id);
        Snackbar.Add("Categoría eliminada", Severity.Warning);
        await CargarDatos();
    }
}