@page "/lotes"
@using Microsoft.AspNetCore.Authorization
@using XpressMarket.Shared.Models
@using XpressMarket.Shared.Extensions
@using MudBlazor
@attribute [Authorize(Roles = "Administrador")]
@inject LoteService LoteSvc
@inject ProductoService ProductoSvc
@inject ProveedorService ProveedorSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Lotes - XpressMarket</PageTitle>

<div class="pa-3 pa-sm-4 pa-md-6">

    @* ==================== BANNER ==================== *@
    <MudPaper Elevation="0" Class="pa-4 pa-sm-5 pa-md-6 mb-4 mb-md-6 rounded-xl"
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div class="d-flex flex-column flex-md-row justify-between align-start align-md-center gap-3">
            <div>
                <div class="d-flex align-center gap-2 mb-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;"
                             Class="fw-bold">
                        Inventario
                    </MudChip>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold mb-1"
                         Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2); font-size: clamp(1.4rem, 4vw, 2.125rem);">
                    Gestión de Lotes
                </MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                    Administra entradas, vencimientos y stock por lote.
                </MudText>
            </div>
            <div class="d-none d-md-block">
                <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
            </div>
        </div>
    </MudPaper>

    @* ==================== CONTENIDO ==================== *@
    <MudPaper Elevation="2" Class="pa-3 pa-sm-4 pa-md-5 rounded-xl">
        <div class="d-flex flex-column flex-sm-row justify-between align-start align-sm-center gap-3 mb-4">
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">
                Listado de Lotes
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #6b2181; color: #ffffff; font-weight: bold;"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AbrirFormularioNuevo"
                       Class="rounded-lg">
                Nuevo Lote
            </MudButton>
        </div>

        <div class="d-flex flex-column flex-md-row gap-3 mb-3">
            <MudTextField T="string" Value="_busqueda" ValueChanged="OnBusquedaCambiada"
                          Placeholder="Buscar por N° de lote o producto..."
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="400" Class="flex-grow-1" />
            <MudSelect T="string" Label="Estado" Value="_estado" ValueChanged="OnEstadoCambiado"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 220px;">
                <MudSelectItem T="string" Value="@("todos")">Todos</MudSelectItem>
                <MudSelectItem T="string" Value="@("vencidos")">Vencidos</MudSelectItem>
                <MudSelectItem T="string" Value="@("por-vencer")">Próximos a vencer (30 días)</MudSelectItem>
                <MudSelectItem T="string" Value="@("vigentes")">Vigentes</MudSelectItem>
            </MudSelect>
        </div>

        <MudTable @ref="_tabla" T="Lote" ServerData="CargarServidor" RowsPerPage="20" Hover="true" Dense="true" Elevation="0" Class="rounded-lg"
                  Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">N° Lote</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Producto</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Proveedor</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Vencimiento</MudText></MudTh>
                    <MudTh Class="text-center"><MudText Typo="Typo.subtitle2" Class="fw-bold">Cantidad</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Estado</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Acciones</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="N° Lote">
                        <MudText Typo="Typo.body1" Class="fw-bold" Style="color: #6b2181;">
                            @context.NumeroLote
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Producto">
                        <MudText Typo="Typo.body2">@(context.Producto?.Nombre ?? "-")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Proveedor">
                        <MudText Typo="Typo.body2" Style="color: #6c757d;">
                            @(context.Proveedor?.Nombre ?? "-")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Vencimiento">
                        <MudText Typo="Typo.body2">@context.FechaVencimiento.ToString("dd/MM/yyyy")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Cantidad" Class="text-center">
                        <MudText Typo="Typo.body1" Class="fw-bold">@context.CantidadActual</MudText>
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        @if (context.Vencido)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Error">
                                Vencido
                            </MudChip>
                        }
                        else if (context.ProximoAVencer)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.AccessTime">
                                Vence en @context.DiasParaVencer días
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.CheckCircle">
                                OK
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Acciones" Class="text-end">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info"
                                               Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="() => AbrirFormularioEditar(context)" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="() => EliminarLote(context.Id)" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                        <NoRecordsContent>
                <MudText Typo="Typo.body1" Class="pa-6" Style="color: #6c757d;">No se encontraron lotes.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText Typo="Typo.body2" Class="pa-4">Cargando...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</div>

@code {
    private MudTable<Lote>? _tabla;
    private string? _busqueda;
    private string _estado = "todos";

    private async Task CargarDatos() => await Recargar();

    // El servidor filtra, ordena y pagina: sólo viaja la página que se está viendo.
    private async Task<TableData<Lote>> CargarServidor(TableState state, CancellationToken ct)
    {
        try
        {
            var r = await LoteSvc.ObtenerPaginadoAsync(state.Page + 1, state.PageSize, _busqueda, _estado);
            return new TableData<Lote> { Items = r.Items, TotalItems = r.Total };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
            return new TableData<Lote> { Items = new List<Lote>(), TotalItems = 0 };
        }
    }

    private async Task Recargar(bool volverAlInicio = false)
    {
        if (_tabla == null) return;
        if (volverAlInicio && _tabla.CurrentPage != 0) _tabla.NavigateTo(0);
        else await _tabla.ReloadServerData();
    }

    private async Task OnBusquedaCambiada(string? texto)
    {
        _busqueda = texto;
        await Recargar(true);
    }

    private async Task OnEstadoCambiado(string estado)
    {
        _estado = estado;
        await Recargar(true);
    }

    private async Task AbrirFormularioNuevo()
    {
        var modelo = new Lote
        {
            Activo = true,
            FechaIngreso = DateTime.Now,
            FechaVencimiento = DateTime.Now.AddMonths(6)
        };

        var parametros = new DialogParameters<LoteDialog>
        {
            { x => x.Lote, modelo },
            { x => x.EsNuevo, true }
        };

        var opciones = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<LoteDialog>("Nuevo Lote", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            await CargarDatos();
        }
    }

    private async Task AbrirFormularioEditar(Lote lote)
    {
        var modelo = new Lote
        {
            Id = lote.Id,
            NumeroLote = lote.NumeroLote,
            ProductoId = lote.ProductoId,
            ProveedorId = lote.ProveedorId,
            FechaIngreso = lote.FechaIngreso,
            FechaVencimiento = lote.FechaVencimiento,
            CantidadInicial = lote.CantidadInicial,
            CantidadActual = lote.CantidadActual,
            PrecioCosto = lote.PrecioCosto,
            Activo = lote.Activo
        };

        var parametros = new DialogParameters<LoteDialog>
        {
            { x => x.Lote, modelo },
            { x => x.EsNuevo, false }
        };

        var opciones = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<LoteDialog>("Editar Lote", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            await CargarDatos();
        }
    }

    private async Task EliminarLote(int id)
    {
        var parametros = new DialogParameters<MudMessageBox>
        {
            { x => x.Title, "Confirmar eliminación" },
            { x => x.Message, "¿Estás seguro de eliminar este lote? El stock del producto se ajustará automáticamente." },
            { x => x.YesText, "Sí, eliminar" },
            { x => x.CancelText, "Cancelar" }
        };

        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>("", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            try
            {
                var eliminado = await LoteSvc.EliminarAsync(id);
                if (eliminado)
                {
                    Snackbar.Add("Lote eliminado", Severity.Warning);
                    await CargarDatos();
                }
                else
                {
                    Snackbar.Add("No se pudo eliminar el lote", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }
}