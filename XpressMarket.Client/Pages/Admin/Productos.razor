@page "/productos"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject ProductoService ProductoSvc
@inject CategoriaService CategoriaSvc
@inject NavigationManager NavManager
@using XpressMarket.Shared.Models
@using XpressMarket.Shared.Extensions

<PageTitle>Productos - XpressMarket</PageTitle>

<div class="container-fluid px-0">
    <!-- Header de Sección -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">Gestión de Productos</h3>
            <p class="text-muted small mb-0">Administra el catálogo de productos, precios y niveles de stock.</p>
        </div>
        <button class="btn btn-primary shadow-sm d-flex align-items-center gap-2 px-3 py-2" @onclick="AbrirFormularioNuevo">
            <i class="bi bi-plus-lg fs-6"></i>
            <span class="fw-semibold">Nuevo Producto</span>
        </button>
    </div>

    <!-- Contenido Principal -->
    @if (cargando)
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <p class="text-muted mb-0">Cargando productos...</p>
            </div>
        </div>
    }
    else if (productos == null || !productos.Any())
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-5">
                <i class="bi bi-box-seam display-4 text-muted mb-3 d-block"></i>
                <h5 class="text-secondary fw-normal">No hay productos registrados</h5>
                <p class="text-muted small mb-3">Comienza agregando un nuevo producto al catálogo.</p>
                <button class="btn btn-outline-primary btn-sm" @onclick="AbrirFormularioNuevo">
                    <i class="bi bi-plus-lg me-1"></i> Crear primer producto
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase fw-semibold border-bottom">
                        <tr>
                            <th class="ps-4 py-3">Nombre</th>
                            <th class="py-3">Categoría</th>
                            <th class="py-3">Precio Venta</th>
                            <th class="py-3 text-center">Stock Actual</th>
                            <th class="py-3 text-center">Stock Mínimo</th>
                            <th class="py-3">Estado</th>
                            <th class="pe-4 py-3 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var producto in productos)
                        {
                            <tr class="@(producto.StockBajo ? "table-warning bg-opacity-25" : "")">
                                <td class="ps-4 fw-semibold text-dark">@producto.Nombre</td>
                                <td class="text-muted small">@(producto.Categoria?.Nombre ?? "-")</td>
                                <td class="fw-semibold">@producto.PrecioVenta.Bs()</td>
                                <td class="text-center fw-semibold">@producto.StockActual</td>
                                <td class="text-center text-muted small">@producto.StockMinimo</td>
                                <td>
                                    @if (producto.StockBajo)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Stock Bajo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i>OK
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-secondary" @onclick="() => AbrirFormularioEditar(producto)" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" @onclick="() => EliminarProducto(producto.Id)" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Modal Formulario -->
    @if (mostrarFormulario)
    {
        <div class="modal fade show d-block tab-modal-backdrop" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header bg-light border-bottom py-3">
                        <h5 class="modal-title fw-bold text-dark">
                            <i class="bi bi-box-seam me-2 text-primary"></i>
                            @(productoEditando.Id == 0 ? "Nuevo Producto" : "Editar Producto")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
                    </div>

                    <EditForm Model="productoEditando" OnValidSubmit="GuardarProducto">
                        <div class="modal-body p-4">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger p-2 small mb-3" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-secondary">Nombre</label>
                                <InputText class="form-control" @bind-Value="productoEditando.Nombre" placeholder="Ej. Galletas de Chocolate 100g" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-secondary">Descripción</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="productoEditando.Descripcion" placeholder="Descripción opcional del producto..." />
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-secondary">Categoría</label>
                                    <InputSelect class="form-select" @bind-Value="productoEditando.CategoriaId">
                                        <option value="0">-- Seleccione --</option>
                                        @if (categorias != null)
                                        {
                                            @foreach (var cat in categorias)
                                            {
                                                <option value="@cat.Id">@cat.Nombre</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-secondary">Código de Barras</label>
                                    <InputText class="form-control" @bind-Value="productoEditando.CodigoBarras" placeholder="Ej. 7791234567890" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-secondary">Precio Costo</label>
                                    @if (productoEditando.Id == 0)
                                    {
                                        <div class="input-group">
                                            <span class="input-group-text">Bs</span>
                                            <InputNumber class="form-control" @bind-Value="productoEditando.PrecioCosto" />
                                        </div>
                                        <div class="form-text small">Costo inicial estimado (se actualizará automáticamente con cada lote registrado).</div>
                                    }
                                    else
                                    {
                                        <input class="form-control bg-light" value="@($"{productoEditando.PrecioCosto.ToString("N2")} Bs (solo lectura)")" disabled />
                                        <div class="form-text small">Se actualiza únicamente al registrar un nuevo lote.</div>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-secondary">Precio Venta</label>
                                    <div class="input-group">
                                        <span class="input-group-text">Bs</span>
                                        <InputNumber class="form-control" @bind-Value="productoEditando.PrecioVenta" />
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-secondary">Stock Actual</label>
                                    <input class="form-control bg-light" value="@($"{productoEditando.StockActual} unidades (solo lectura)")" disabled />
                                    <div class="form-text small">Se actualiza automáticamente al registrar o vender lotes en la sección Lotes.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-secondary">Stock Mínimo</label>
                                    <InputNumber class="form-control" @bind-Value="productoEditando.StockMinimo" />
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer bg-light border-top py-2 px-4">
                            <button type="button" class="btn btn-outline-secondary px-3" @onclick="CerrarFormulario">Cancelar</button>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">Guardar Producto</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Producto>? productos;
    private List<Categoria>? categorias;
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private Producto productoEditando = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        categorias = await CategoriaSvc.ObtenerTodasAsync();
        productos = await ProductoSvc.ObtenerTodosAsync();
        cargando = false;
    }

    private void AbrirFormularioNuevo()
    {
        productoEditando = new Producto { Activo = true, StockActual = 0 };
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(Producto producto)
    {
        // Se clona para no modificar la lista en pantalla hasta guardar
        productoEditando = new Producto
        {
            Id = producto.Id,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            PrecioVenta = producto.PrecioVenta,
            PrecioCosto = producto.PrecioCosto,
            StockActual = producto.StockActual,
            StockMinimo = producto.StockMinimo,
            CodigoBarras = producto.CodigoBarras,
            Activo = producto.Activo,
            CategoriaId = producto.CategoriaId
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarProducto()
    {
        if (productoEditando.Id == 0)
        {
            await ProductoSvc.CrearAsync(productoEditando);
        }
        else
        {
            await ProductoSvc.ActualizarAsync(productoEditando.Id, productoEditando);
        }

        mostrarFormulario = false;
        await CargarDatos();
    }

    private async Task EliminarProducto(int id)
    {
        await ProductoSvc.EliminarAsync(id);
        await CargarDatos();
    }
}