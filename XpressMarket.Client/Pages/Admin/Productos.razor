@page "/productos"
@using Microsoft.AspNetCore.Authorization
@using XpressMarket.Shared.Models
@using XpressMarket.Shared.Extensions
@using MudBlazor
@attribute [Authorize(Roles = "Administrador")]
@inject ProductoService ProductoSvc
@inject CategoriaService CategoriaSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Productos - XpressMarket</PageTitle>

<div class="pa-3 pa-sm-4 pa-md-6">

    <MudPaper Elevation="0" Class="pa-4 pa-sm-5 pa-md-6 mb-4 mb-md-6 rounded-xl"
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div class="d-flex flex-column flex-md-row justify-between align-start align-md-center gap-3">
            <div>
                <div class="d-flex align-center gap-2 mb-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;"
                             Class="fw-bold">
                        Catálogo
                    </MudChip>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold mb-1"
                         Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2); font-size: clamp(1.4rem, 4vw, 2.125rem);">
                    Gestión de Productos
                </MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                    Administra catálogo, precios y niveles de stock.
                </MudText>
            </div>
            <div class="d-none d-md-block">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
            </div>
        </div>
    </MudPaper>

    <MudPaper Elevation="2" Class="pa-3 pa-sm-4 pa-md-5 rounded-xl">
        <div class="d-flex flex-column flex-sm-row justify-between align-start align-sm-center gap-3 mb-4">
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">
                Listado de Productos
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #6b2181; color: #ffffff; font-weight: bold;"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AbrirFormularioNuevo"
                       Class="rounded-lg">
                Nuevo Producto
            </MudButton>
        </div>

        <div class="d-flex flex-column flex-md-row gap-3 mb-3">
            <MudTextField T="string" Value="_busqueda" ValueChanged="OnBusquedaCambiada"
                          Placeholder="Buscar por nombre, código o descripción..."
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="400" Class="flex-grow-1" />
            <MudSelect T="int?" Label="Categoría" Value="_categoriaFiltro" ValueChanged="OnCategoriaCambiada"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 220px;">
                <MudSelectItem T="int?" Value="@((int?)null)">Todas</MudSelectItem>
                @if (categorias != null)
                {
                    @foreach (var cat in categorias)
                    {
                        <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Nombre</MudSelectItem>
                    }
                }
            </MudSelect>
        </div>

        <MudTable @ref="_tabla" T="Producto" ServerData="CargarServidor" RowsPerPage="20" Hover="true" Dense="true" Elevation="0" Class="rounded-lg"
                  Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Nombre</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Categoría</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Precio</MudText></MudTh>
                    <MudTh Class="text-center"><MudText Typo="Typo.subtitle2" Class="fw-bold">Stock</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Estado</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Acciones</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nombre">
                        <MudText Typo="Typo.body1" Class="fw-bold">@context.Nombre</MudText>
                    </MudTd>
                    <MudTd DataLabel="Categoría">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="Color.Primary" Icon="@Icons.Material.Filled.Category">
                            @(context.Categoria?.Nombre ?? categorias?.FirstOrDefault(c => c.Id == context.CategoriaId)?.Nombre ?? "Sin categoría")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Precio">
                        <MudText Typo="Typo.body1" Class="fw-bold" Style="color: #6b2181;">
                            @context.PrecioVenta.Bs()
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Stock" Class="text-center">
                        <MudText Typo="Typo.body1" Class="fw-bold">@context.StockActual</MudText>
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        @if (context.StockBajo)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Warning">
                                Stock Bajo
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.CheckCircle">
                                OK
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Acciones" Class="text-end">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info"
                                               Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="() => AbrirFormularioEditar(context)" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="() => EliminarProducto(context.Id)" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                        <NoRecordsContent>
                <MudText Typo="Typo.body1" Class="pa-6" Style="color: #6c757d;">No se encontraron productos.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText Typo="Typo.body2" Class="pa-4">Cargando...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</div>

@code {
    private List<Categoria>? categorias;
    private MudTable<Producto>? _tabla;
    private string? _busqueda;
    private int? _categoriaFiltro;

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        try
        {
            categorias = await CategoriaSvc.ObtenerTodasAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
        }
        await Recargar();
    }

    // El servidor filtra, ordena y pagina: sólo viaja la página que se está viendo.
    private async Task<TableData<Producto>> CargarServidor(TableState state, CancellationToken ct)
    {
        try
        {
            var r = await ProductoSvc.ObtenerPaginadoAsync(state.Page + 1, state.PageSize, _busqueda, _categoriaFiltro);
            return new TableData<Producto> { Items = r.Items, TotalItems = r.Total };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
            return new TableData<Producto> { Items = new List<Producto>(), TotalItems = 0 };
        }
    }

    private async Task Recargar(bool volverAlInicio = false)
    {
        if (_tabla == null) return;
        if (volverAlInicio && _tabla.CurrentPage != 0) _tabla.NavigateTo(0);
        else await _tabla.ReloadServerData();
    }

    private async Task OnBusquedaCambiada(string? texto)
    {
        _busqueda = texto;
        await Recargar(true);
    }

    private async Task OnCategoriaCambiada(int? categoriaId)
    {
        _categoriaFiltro = categoriaId;
        await Recargar(true);
    }

    private async Task AbrirFormularioNuevo()
    {
        var modelo = new Producto { Activo = true, StockActual = 0 };

        var parametros = new DialogParameters<ProductoDialog>
        {
            { x => x.Producto, modelo },
            { x => x.Categorias, categorias ?? new() },
            { x => x.EsNuevo, true }
        };

        var opciones = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<ProductoDialog>("Nuevo Producto", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            await CargarDatos();
        }
    }

    private async Task AbrirFormularioEditar(Producto p)
    {
        var modelo = new Producto
        {
            Id = p.Id,
            Nombre = p.Nombre,
            Descripcion = p.Descripcion,
            PrecioVenta = p.PrecioVenta,
            PrecioCosto = p.PrecioCosto,
            StockActual = p.StockActual,
            StockMinimo = p.StockMinimo,
            CodigoBarras = p.CodigoBarras,
            Activo = p.Activo,
            CategoriaId = p.CategoriaId
        };

        var parametros = new DialogParameters<ProductoDialog>
        {
            { x => x.Producto, modelo },
            { x => x.Categorias, categorias ?? new() },
            { x => x.EsNuevo, false }
        };

        var opciones = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<ProductoDialog>("Editar Producto", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            await CargarDatos();
        }
    }

    private async Task EliminarProducto(int id)
    {
        var parametros = new DialogParameters<MudMessageBox>
        {
            { x => x.Title, "Confirmar eliminación" },
            { x => x.Message, "¿Estás seguro de eliminar este producto?" },
            { x => x.YesText, "Sí, eliminar" },
            { x => x.CancelText, "Cancelar" }
        };

        var opciones = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>("", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            try
            {
                var eliminado = await ProductoSvc.EliminarAsync(id);
                if (eliminado)
                {
                    Snackbar.Add("Producto eliminado", Severity.Warning);
                    await CargarDatos();
                }
                else
                {
                    Snackbar.Add(ProductoSvc.UltimoError ?? "No se puede eliminar el producto: aún tiene unidades en lotes activos. Da de baja esos lotes primero (eliminarlos, o merma si están vencidos)", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }
}