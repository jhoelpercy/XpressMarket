@page "/proveedores"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject ProveedorService ProveedorSvc
@inject ISnackbar Snackbar
@using XpressMarket.Shared.Models

<PageTitle>Proveedores - XpressMarket</PageTitle>

<div class="pa-4 pa-md-6">

    <MudPaper Elevation="0" Class="pa-6 mb-6 rounded-xl d-flex justify-between align-center"
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div>
            <div class="d-flex align-center gap-2 mb-2">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;"
                         Class="fw-bold">
                    Directorio
                </MudChip>
            </div>
            <MudText Typo="Typo.h4" Class="fw-bold mb-1" Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2);">
                Gestión de Proveedores
            </MudText>
            <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                Administra contactos, teléfonos y datos de facturación.
            </MudText>
        </div>
        <div class="d-none d-md-block">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
        </div>
    </MudPaper>

    <MudPaper Elevation="2" Class="pa-5 rounded-xl">
        <div class="d-flex justify-between align-center mb-4">
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">Listado de Proveedores</MudText>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #6b2181; color: #ffffff; font-weight: bold;"
                       StartIcon="@Icons.Material.Filled.AddBusiness"
                       OnClick="AbrirFormularioNuevo" Class="rounded-lg">
                Nuevo Proveedor
            </MudButton>
        </div>

        @if (cargando)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (proveedores == null || !proveedores.Any())
        {
            <div class="d-flex flex-column align-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size: 4rem; color: #adb5bd;" />
                <MudText Typo="Typo.h6" Class="fw-normal mt-3" Style="color: #6c757d;">
                    No hay proveedores registrados
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirFormularioNuevo">
                    Crear primer proveedor
                </MudButton>
            </div>
        }
        else
        {
            <MudTable Items="@proveedores" Hover="true" Dense="true" Elevation="0" Class="rounded-lg">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Nombre</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Contacto</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Teléfono</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Email</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Acciones</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nombre">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Medium" Style="background-color: #f3e5f5; color: #6b2181;">
                                <MudIcon Icon="@Icons.Material.Filled.Business" />
                            </MudAvatar>
                            <MudText Typo="Typo.body1" Class="fw-bold">@context.Nombre</MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Contacto">
                        <MudText Typo="Typo.body2" Style="color: #6c757d;">
                            @(string.IsNullOrWhiteSpace(context.Contacto) ? "-" : context.Contacto)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Teléfono">
                        @if (!string.IsNullOrWhiteSpace(context.Telefono))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Style="color: #6c757d;" />
                                <MudText Typo="Typo.body2">@context.Telefono</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="color: #adb5bd;">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Email">
                        @if (!string.IsNullOrWhiteSpace(context.Email))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Style="color: #6c757d;" />
                                <MudText Typo="Typo.body2">@context.Email</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="color: #adb5bd;">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Acciones" Class="text-end">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info"
                                               Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="() => AbrirFormularioEditar(context)" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="() => EliminarProveedor(context.Id)" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</div>

<MudDialog @bind-IsVisible="mostrarFormulario" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #6b2181;">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
            @(proveedorEditando.Id == 0 ? "Nuevo Proveedor" : "Editar Proveedor")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="proveedorEditando" OnValidSubmit="GuardarProveedor">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger p-2 small mb-3" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nombre de la Empresa" @bind-Value="proveedorEditando.Nombre"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Persona de Contacto" @bind-Value="proveedorEditando.Contacto"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Teléfono" @bind-Value="proveedorEditando.Telefono"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Correo Electrónico" @bind-Value="proveedorEditando.Email"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Dirección / Ubicación" @bind-Value="proveedorEditando.Direccion"
                                  Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="CerrarFormulario" Variant="Variant.Outlined" Color="Color.Default">
                    Cancelar
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Style="background-color: #6b2181; color: #ffffff;">
                    Guardar
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    private List<Proveedor>? proveedores;
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private Proveedor proveedorEditando = new();

    private DialogOptions dialogOptions = new()
    {
        CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true,
        BackdropClick = false, CloseOnEscapeKey = false
    };

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        cargando = true;
        proveedores = await ProveedorSvc.ObtenerTodosAsync();
        cargando = false;
    }

    private void AbrirFormularioNuevo()
    {
        proveedorEditando = new Proveedor { Activo = true };
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(Proveedor p)
    {
        proveedorEditando = new Proveedor
        {
            Id = p.Id, Nombre = p.Nombre, Contacto = p.Contacto,
            Telefono = p.Telefono, Email = p.Email,
            Direccion = p.Direccion, Activo = p.Activo
        };
        mostrarFormulario = true;
    }

    private void CerrarFormulario() => mostrarFormulario = false;

    private async Task GuardarProveedor()
    {
        if (proveedorEditando.Id == 0)
        {
            await ProveedorSvc.CrearAsync(proveedorEditando);
            Snackbar.Add("Proveedor creado", Severity.Success);
        }
        else
        {
            await ProveedorSvc.ActualizarAsync(proveedorEditando.Id, proveedorEditando);
            Snackbar.Add("Proveedor actualizado", Severity.Success);
        }
        mostrarFormulario = false;
        await CargarDatos();
    }

    private async Task EliminarProveedor(int id)
    {
        await ProveedorSvc.EliminarAsync(id);
        Snackbar.Add("Proveedor eliminado", Severity.Warning);
        await CargarDatos();
    }
}