@page "/usuarios"
@using Microsoft.AspNetCore.Authorization
@using XpressMarket.Shared.Models
@using MudBlazor
@attribute [Authorize(Roles = "Administrador")]
@inject UsuarioService UsuarioSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Usuarios - XpressMarket</PageTitle>

<div class="pa-3 pa-sm-4 pa-md-6">

    @* ==================== BANNER ==================== *@
    <MudPaper Elevation="0" Class="pa-4 pa-sm-5 pa-md-6 mb-4 mb-md-6 rounded-xl"
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div class="d-flex flex-column flex-md-row justify-between align-start align-md-center gap-3">
            <div>
                <div class="d-flex align-center gap-2 mb-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;"
                             Class="fw-bold">
                        Accesos
                    </MudChip>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold mb-1"
                         Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2); font-size: clamp(1.4rem, 4vw, 2.125rem);">
                    Gestión de Usuarios
                </MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                    Administra cuentas, roles y permisos del sistema.
                </MudText>
            </div>
            <div class="d-none d-md-block">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
            </div>
        </div>
    </MudPaper>

    @* ==================== CONTENIDO ==================== *@
    <MudPaper Elevation="2" Class="pa-3 pa-sm-4 pa-md-5 rounded-xl">
        <div class="d-flex flex-column flex-sm-row justify-between align-start align-sm-center gap-3 mb-4">
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">
                Listado de Usuarios
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #6b2181; color: #ffffff; font-weight: bold;"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="AbrirFormularioNuevo"
                       Class="rounded-lg">
                Nuevo Usuario
            </MudButton>
        </div>

        @if (cargando)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (usuarios == null || !usuarios.Any())
        {
            <div class="d-flex flex-column align-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.People" Style="font-size: 4rem; color: #adb5bd;" />
                <MudText Typo="Typo.h6" Class="fw-normal mt-3" Style="color: #6c757d;">
                    No hay usuarios registrados
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirFormularioNuevo">
                    Crear primer usuario
                </MudButton>
            </div>
        }
        else
        {
            <MudTable Items="@usuarios" Hover="true" Dense="true" Elevation="0" Class="rounded-lg"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Usuario</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Rol</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Estado</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Acciones</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Usuario">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Medium" Style="background-color: #f3e5f5; color: #6b2181;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1" Class="fw-bold">@context.NombreUsuario</MudText>
                                @if (!string.IsNullOrWhiteSpace(context.NombreCompleto))
                                {
                                    <MudText Typo="Typo.caption" Style="color: #6c757d;">@context.NombreCompleto</MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Rol">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.Shield" Color="Color.Primary">
                            @context.Rol
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        @if (context.Activo)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.CheckCircle">
                                Activo
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Cancel">
                                Inactivo
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Acciones" Class="text-end">
                        <MudTooltip Text="Editar usuario">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           OnClick="() => AbrirFormularioEditar(context)" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</div>

@code {
    private List<UsuarioResponse> usuarios = new();
    private bool cargando = true;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            usuarios = await UsuarioSvc.ObtenerTodosAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AbrirFormularioNuevo()
    {
        var parametros = new DialogParameters<UsuarioDialog>
        {
            { x => x.EsNuevo, true },
            { x => x.UsuarioId, 0 }
        };

        var opciones = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<UsuarioDialog>("Nuevo Usuario", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            await Cargar();
        }
    }

    private async Task AbrirFormularioEditar(UsuarioResponse u)
    {
        var parametros = new DialogParameters<UsuarioDialog>
        {
            { x => x.EsNuevo, false },
            { x => x.UsuarioId, u.Id }
        };

        var opciones = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false,
            CloseOnEscapeKey = false
        };

        var dialog = await DialogService.ShowAsync<UsuarioDialog>("Editar Usuario", parametros, opciones);
        var resultado = await dialog.Result;

        if (resultado != null && !resultado.Canceled)
        {
            await Cargar();
        }
    }
}