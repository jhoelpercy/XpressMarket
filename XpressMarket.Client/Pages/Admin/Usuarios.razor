@page "/usuarios"
@attribute [Authorize(Roles = "Administrador")]
@inject UsuarioService UsuarioSvc
@inject ISnackbar Snackbar
@using XpressMarket.Shared.Models

<PageTitle>Usuarios - XpressMarket</PageTitle>

<div class="pa-4 pa-md-6">

    <MudPaper Elevation="0" Class="pa-6 mb-6 rounded-xl d-flex justify-between align-center"
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div>
            <div class="d-flex align-center gap-2 mb-2">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;"
                         Class="fw-bold">
                    Accesos
                </MudChip>
            </div>
            <MudText Typo="Typo.h4" Class="fw-bold mb-1" Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2);">
                Gestión de Usuarios
            </MudText>
            <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                Administra cuentas, roles y permisos del sistema.
            </MudText>
        </div>
        <div class="d-none d-md-block">
            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
        </div>
    </MudPaper>

    <MudPaper Elevation="2" Class="pa-5 rounded-xl">
        <div class="d-flex justify-between align-center mb-4">
            <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">
                Listado de Usuarios
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #6b2181; color: #ffffff; font-weight: bold;"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="AbrirFormularioNuevo"
                       Class="rounded-lg">
                Nuevo Usuario
            </MudButton>
        </div>

        @if (cargando)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (usuarios == null || !usuarios.Any())
        {
            <div class="d-flex flex-column align-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.People" Style="font-size: 4rem; color: #adb5bd;" />
                <MudText Typo="Typo.h6" Class="fw-normal mt-3" Style="color: #6c757d;">
                    No hay usuarios registrados
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirFormularioNuevo">
                    Crear primer usuario
                </MudButton>
            </div>
        }
        else
        {
            <MudTable Items="@usuarios" Hover="true" Dense="true" Elevation="0" Class="rounded-lg">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Usuario</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Rol</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Estado</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Acciones</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Usuario">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Medium" Style="background-color: #f3e5f5; color: #6b2181;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                            <MudText Typo="Typo.body1" Class="fw-bold">@context.NombreUsuario</MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Rol">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.Shield" Color="Color.Primary">
                            @context.Rol
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        @if (context.Activo)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.CheckCircle">
                                Activo
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Cancel">
                                Inactivo
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Acciones" Class="text-end">
                        <MudTooltip Text="Editar usuario">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           OnClick="() => AbrirFormularioEditar(context)" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</div>

@* ==================== DIÁLOGO NUEVO USUARIO ==================== *@
<MudDialog @bind-IsVisible="mostrarFormularioNuevo" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #6b2181;">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
            Nuevo Usuario
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="nuevoUsuario" OnValidSubmit="GuardarNuevo">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger p-2 small mb-3" />

            <MudTextField Label="Nombre Completo" @bind-Value="nuevoUsuario.NombreCompleto"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField Label="Nombre de Usuario" @bind-Value="nuevoUsuario.NombreUsuario"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField Label="Contraseña" @bind-Value="nuevoUsuario.Contrasena"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudSelect T="string" Label="Rol" @bind-Value="nuevoUsuario.Rol"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="string" Value="@("Cajero")">Cajero</MudSelectItem>
                <MudSelectItem T="string" Value="@("Administrador")">Administrador</MudSelectItem>
            </MudSelect>

            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="CancelarAccion" Variant="Variant.Outlined" Color="Color.Default">
                    Cancelar
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Style="background-color: #6b2181; color: #ffffff;">
                    Guardar
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@* ==================== DIÁLOGO EDITAR USUARIO ==================== *@
<MudDialog @bind-IsVisible="mostrarFormularioEditar" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #6b2181;">
            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="mr-2" />
            Editar Usuario: @usuarioEditando?.NombreUsuario
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="edicion" OnValidSubmit="GuardarEdicion">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger p-2 small mb-3" />

            <MudSelect T="string" Label="Rol" @bind-Value="edicion.Rol"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="string" Value="@("Cajero")">Cajero</MudSelectItem>
                <MudSelectItem T="string" Value="@("Administrador")">Administrador</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool" @bind-Value="edicion.Activo" Label="Usuario Activo"
                       Color="Color.Primary" Class="mb-3" />

            <MudTextField Label="Nueva Contraseña" @bind-Value="edicion.NuevaContrasena"
                          InputType="InputType.Password"
                          HelperText="Dejar en blanco para no cambiarla"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="CancelarAccion" Variant="Variant.Outlined" Color="Color.Default">
                    Cancelar
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Style="background-color: #6b2181; color: #ffffff;">
                    Guardar Cambios
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    private List<UsuarioResponse> usuarios = new();
    private bool cargando = true;

    private bool mostrarFormularioNuevo = false;
    private UsuarioCreateRequest nuevoUsuario = new();

    private bool mostrarFormularioEditar = false;
    private UsuarioResponse? usuarioEditando;
    private UsuarioUpdateRequest edicion = new();

    private DialogOptions dialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        BackdropClick = false,
        CloseOnEscapeKey = false
    };

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        usuarios = await UsuarioSvc.ObtenerTodosAsync();
        cargando = false;
    }

    private void AbrirFormularioNuevo()
    {
        nuevoUsuario = new UsuarioCreateRequest { Rol = "Cajero" };
        mostrarFormularioNuevo = true;
    }

    private async Task GuardarNuevo()
    {
        var (exito, error) = await UsuarioSvc.CrearAsync(nuevoUsuario);
        if (exito)
        {
            Snackbar.Add("Usuario creado correctamente", Severity.Success);
            mostrarFormularioNuevo = false;
            await Cargar();
        }
        else
        {
            Snackbar.Add(error ?? "No se pudo crear el usuario", Severity.Error);
        }
    }

    private void AbrirFormularioEditar(UsuarioResponse u)
    {
        usuarioEditando = u;
        edicion = new UsuarioUpdateRequest { Rol = u.Rol, Activo = u.Activo };
        mostrarFormularioEditar = true;
    }

    private async Task GuardarEdicion()
    {
        if (usuarioEditando == null) return;

        var (exito, error) = await UsuarioSvc.ActualizarAsync(usuarioEditando.Id, edicion);
        if (exito)
        {
            Snackbar.Add("Usuario actualizado", Severity.Success);
            mostrarFormularioEditar = false;
            await Cargar();
        }
        else
        {
            Snackbar.Add(error ?? "No se pudo actualizar", Severity.Error);
        }
    }

    private void CancelarAccion()
    {
        mostrarFormularioNuevo = false;
        mostrarFormularioEditar = false;
    }
}