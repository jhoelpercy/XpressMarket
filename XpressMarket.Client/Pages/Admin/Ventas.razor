@page "/ventas"
@using Microsoft.AspNetCore.Authorization
@using XpressMarket.Shared.Models
@using XpressMarket.Shared.Extensions
@using MudBlazor
@attribute [Authorize(Roles = "Administrador")]
@inject VentaService VentaSvc
@inject NavigationManager NavManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Historial de Ventas - XpressMarket</PageTitle>

<div class="pa-3 pa-sm-4 pa-md-6">

    @* ==================== BANNER ==================== *@
    <MudPaper Elevation="0" Class="pa-4 pa-sm-5 pa-md-6 mb-4 mb-md-6 rounded-xl"
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div class="d-flex flex-column flex-md-row justify-between align-start align-md-center gap-3">
            <div>
                <div class="d-flex align-center gap-2 mb-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;"
                             Class="fw-bold">
                        Historial
                    </MudChip>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold mb-1"
                         Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2); font-size: clamp(1.4rem, 4vw, 2.125rem);">
                    Historial de Ventas
                </MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                    Consulta las ventas realizadas, emite comprobantes y gestiona anulaciones.
                </MudText>
            </div>
            <div class="d-none d-md-block">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
            </div>
        </div>
    </MudPaper>

    @* ==================== ADVERTENCIA DE ANULACIÓN ==================== *@
    @if (ventaIdParaAnular != null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4 rounded-lg">
            <MudText Typo="Typo.h6" Class="fw-bold mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                Atención antes de anular la Venta N° @ventaIdParaAnular
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Se detectaron las siguientes observaciones en los lotes de origen:
            </MudText>

            <MudPaper Elevation="0" Class="pa-3 mb-3 rounded-lg" Style="background: rgba(255,255,255,0.7);">
                <MudList T="string" Dense="true">
                    @foreach (var a in advertenciasPendientes)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.WarningAmber" IconColor="Color.Warning">
                            <MudText Typo="Typo.body2">
                                <strong>@a.NombreProducto</strong> (Lote @a.NumeroLote, @a.Cantidad unids.) —
                                <span Style="color: #d32f2f; font-weight: 600;">@a.Motivo</span>
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>

            <MudText Typo="Typo.caption" Class="mb-3 d-block">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                El stock global del producto se restablecerá, pero el lote de origen no aceptará la reactivación de estas unidades.
            </MudText>

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="AnularForzado">
                    Sí, anular de todas formas
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           OnClick="CancelarAnulacion">
                    Cancelar
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    @* ==================== CONTENIDO PRINCIPAL ==================== *@
    @if (cargando)
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex justify-center align-center rounded-xl" Style="background: #ffffff;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </MudPaper>
    }
    else if (ventas == null || !ventas.Any())
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column justify-center align-center rounded-xl" Style="background: #ffffff;">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Style="font-size: 4rem; color: #adb5bd;" />
            <MudText Typo="Typo.h6" Class="fw-normal mt-3" Style="color: #6c757d;">
                No se encontraron ventas registradas
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #adb5bd;">
                Las transacciones realizadas desde la caja aparecerán aquí.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="2" Class="rounded-xl overflow-hidden">
            <MudTable Items="@ventas" Hover="true" Dense="true" Elevation="0"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">N° Venta</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Fecha y Hora</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Cajero</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Total</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Estado</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Acciones</MudText></MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="N° Venta">
                        <MudText Typo="Typo.body1" Class="fw-bold" Style="color: #6b2181;">
                            #@context.Id
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Fecha y Hora">
                        <MudText Typo="Typo.body2" Style="color: #6c757d;">
                            @context.FechaVenta.ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Cajero">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Small" Style="background-color: #f3e5f5; color: #6b2181;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Class="fw-medium">@context.NombreUsuario</MudText>
                        </MudStack>
                    </MudTd>

                    <MudTd DataLabel="Total">
                        <MudText Typo="Typo.body1" Class="fw-bold">@context.Total.Bs()</MudText>
                    </MudTd>

                    <MudTd DataLabel="Estado">
                        @if (context.Estado == EstadoVenta.Completada)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.CheckCircle">
                                Completada
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Cancel">
                                Anulada
                            </MudChip>
                        }
                    </MudTd>

                    <MudTd DataLabel="Acciones" Class="text-end">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudTooltip Text="Ver / Imprimir comprobante">
                                <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               OnClick="() => VerComprobante(context.Id)" />
                            </MudTooltip>

                            @if (context.Estado == EstadoVenta.Completada)
                            {
                                <MudTooltip Text="Anular venta">
                                    <MudIconButton Icon="@Icons.Material.Filled.Block"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   OnClick="() => ConfirmarAnular(context.Id)" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</div>

@code {
    private List<Venta> ventas = new();
    private bool cargando = true;
    private List<AdvertenciaAnulacion> advertenciasPendientes = new();
    private int? ventaIdParaAnular;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            ventas = await VentaSvc.ObtenerTodasAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar ventas: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void VerComprobante(int ventaId)
    {
        NavManager.NavigateTo($"/comprobante-venta/{ventaId}");
    }

    private async Task ConfirmarAnular(int ventaId)
    {
        try
        {
            // Primero intenta anular directo (caso normal)
            var (exito, requiereConfirmacion, advertencias) = await VentaSvc.AnularVentaAsync(ventaId);

            if (exito)
            {
                Snackbar.Add("Venta anulada correctamente", Severity.Success);
                await Cargar();
                return;
            }

            // Si el backend pide confirmación adicional (porque hay lotes inactivos),
            // mostramos el panel de advertencias
            if (requiereConfirmacion)
            {
                ventaIdParaAnular = ventaId;
                advertenciasPendientes = advertencias ?? new();
            }
            else
            {
                Snackbar.Add("No se pudo anular la venta", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al anular: {ex.Message}", Severity.Error);
        }
    }

    private async Task AnularForzado()
    {
        if (ventaIdParaAnular == null) return;

        try
        {
            var (exito, _, _) = await VentaSvc.AnularVentaAsync(ventaIdParaAnular.Value, forzar: true);
            if (exito)
                Snackbar.Add("Venta anulada forzadamente", Severity.Warning);
            else
                Snackbar.Add("No se pudo anular la venta", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            ventaIdParaAnular = null;
            advertenciasPendientes.Clear();
            await Cargar();
        }
    }

    private void CancelarAnulacion()
    {
        ventaIdParaAnular = null;
        advertenciasPendientes.Clear();
    }
}