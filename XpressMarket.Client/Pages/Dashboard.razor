@page "/dashboard"
@attribute [Authorize(Roles = "Administrador")]
@inject VentaService VentaSvc
@inject IJSRuntime JS
@inject ReporteService ReporteSvc
@using XpressMarket.Shared.Models
@using XpressMarket.Shared.Extensions

<PageTitle>Dashboard</PageTitle>

<h3>Dashboard de KPIs</h3>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (resumen != null)
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white" style="background-color:#1F3D2B;">
                <div class="card-body">
                    <h6>Ventas (30 días)</h6>
                    <p class="display-6">@resumen.TotalVentasPeriodo.Bs()</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-dark" style="background-color:#D9A544;">
                <div class="card-body">
                    <h6>Utilidad (30 días)</h6>
                    <p class="display-6">@resumen.TotalUtilidadPeriodo.Bs()</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-dark bg-warning">
                <div class="card-body">
                    <h6>Stock Bajo</h6>
                    <p class="display-6">@resumen.ProductosStockBajo</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-dark bg-info">
                <div class="card-body">
                    <h6>Lotes por Vencer</h6>
                    <p class="display-6">@resumen.LotesPorVencer</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-7">
            <h5>Ventas por Día</h5>
            <canvas id="graficoVentas"></canvas>
        </div>
        <div class="col-md-5">
            <h5>Productos Más Vendidos</h5>
            <canvas id="graficoProductos"></canvas>
        </div>
    </div>
    <hr class="my-4" />

    <h5>Informe Gerencial</h5>
    <p class="text-muted small">Descarga un informe en PDF con ventas, utilidad, mermas, stock bajo y lotes por vencer de un período específico.</p>

    @if (errorInforme != null)
    {
        <div class="alert alert-danger">@errorInforme</div>
    }

    <div class="row mb-2">
        <div class="col-auto">
            <label>Desde</label>
            <input type="date" class="form-control" @bind="desdeInforme" />
        </div>
        <div class="col-auto">
            <label>Hasta</label>
            <input type="date" class="form-control" @bind="hastaInforme" />
        </div>
        <div class="col-auto d-flex align-items-end gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="SeleccionarHoy">Hoy</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="SeleccionarEsteMes">Este Mes</button>
        </div>
    </div>

    <button class="btn btn-primary" @onclick="DescargarInforme" disabled="@generandoInforme">
        @(generandoInforme ? "Generando..." : "Descargar Informe PDF")
    </button>
}

@code {
    private DashboardResumen? resumen;
    private bool cargando = true;
    private bool graficosPendientes = false;
    private DateTime desdeInforme = DateTime.Now.Date;
    private DateTime hastaInforme = DateTime.Now.Date;
    private bool generandoInforme = false;
    private string? errorInforme;

    private void SeleccionarHoy()
    {
        desdeInforme = DateTime.Now.Date;
        hastaInforme = DateTime.Now.Date;
    }

    private void SeleccionarEsteMes()
    {
        desdeInforme = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        hastaInforme = DateTime.Now.Date;
    }

    private async Task DescargarInforme()
    {
        errorInforme = null;
        generandoInforme = true;

        try
        {
            var bytes = await ReporteSvc.ObtenerInformeGerencialPdfAsync(desdeInforme, hastaInforme);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("descargarArchivo", $"Informe_Gerencial_{desdeInforme:yyyyMMdd}_{hastaInforme:yyyyMMdd}.pdf", base64);
        }
        catch (Exception ex)
        {
            errorInforme = $"Error al generar el informe: {ex.Message}";
        }

        generandoInforme = false;
    }

    protected override async Task OnInitializedAsync()
    {
        resumen = await VentaSvc.ObtenerDashboardAsync();
        cargando = false;
        graficosPendientes = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (graficosPendientes && resumen != null)
        {
            graficosPendientes = false;

            var labelsVentas = resumen.VentasPorDia.Select(v => v.Fecha.ToString("dd/MM")).ToArray();
            var datosVentas = resumen.VentasPorDia.Select(v => v.Total).ToArray();
            await JS.InvokeVoidAsync("renderizarGraficoLinea", "graficoVentas", labelsVentas, datosVentas, "#1F3D2B", "rgba(31,61,43,0.1)", "Ventas (Bs)");

            var labelsProductos = resumen.TopProductos.Select(p => p.NombreProducto).ToArray();
            var datosProductos = resumen.TopProductos.Select(p => p.CantidadVendida).ToArray();
            await JS.InvokeVoidAsync("renderizarGraficoBarras", "graficoProductos", labelsProductos, datosProductos, "#D9A544", "Unidades vendidas");
        }
    }
}