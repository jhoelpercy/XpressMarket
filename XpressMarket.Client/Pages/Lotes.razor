@page "/lotes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject LoteService LoteSvc
@inject ProductoService ProductoSvc
@inject ProveedorService ProveedorSvc
@using XpressMarket.Shared.Models

<PageTitle>Lotes</PageTitle>

<h3>Gestión de Lotes</h3>

<button class="btn btn-primary mb-3" @onclick="AbrirFormularioNuevo">
    Nuevo Lote
</button>

@if (cargando)
{
    <p><em>Cargando lotes...</em></p>
}
else if (lotes == null || !lotes.Any())
{
    <p>No hay lotes registrados.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>N° Lote</th>
                <th>Producto</th>
                <th>Registrado Por</th>
                <th>Proveedor</th>
                <th>Fecha Vencimiento</th>
                <th>Cantidad Actual</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lote in lotes)
            {
                <tr class="@ClaseEstado(lote)">
                    <td>@lote.NumeroLote</td>
                    <td>@lote.Producto?.Nombre</td>
                    <td>@(lote.RegistradoPorNombre ?? "-")</td>
                    <td>@(lote.Proveedor?.Nombre ?? "-")</td>
                    <td>@lote.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                    <td>@lote.CantidadActual</td>
                    <td>
                        @if (lote.Vencido)
                        {
                            <span class="badge bg-danger">Vencido</span>
                        }
                        else if (lote.ProximoAVencer)
                        {
                            <span class="badge bg-warning text-dark">Vence en @lote.DiasParaVencer días</span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-secondary" @onclick="() => AbrirFormularioEditar(lote)">
                            Editar
                        </button>
                        <button class="btn btn-sm btn-danger ms-1" @onclick="() => EliminarLote(lote.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarFormulario)
{
    <div class="card p-3 mt-3 shadow-sm">
        <h4>@(loteEditando.Id == 0 ? "Nuevo Lote" : "Editar Lote")</h4>

        <EditForm Model="loteEditando" OnValidSubmit="GuardarLote">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-2">
                <label class="form-label">Número de Lote</label>
                <InputText class="form-control" @bind-Value="loteEditando.NumeroLote" />
            </div>

            <div class="mb-2">
                <label class="form-label">Producto</label>
                @if (loteEditando.Id > 0)
                {
                    <!-- Al editar un lote existente, el producto no cambia -->
                    <input class="form-control" value="@productoSeleccionadoNombre" disabled />
                }
                else if (productoSeleccionadoNombre != null)
                {
                    <div class="alert alert-secondary d-flex justify-content-between align-items-center py-2 mb-0">
                        <span>@productoSeleccionadoNombre</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="QuitarProductoSeleccionado">
                            Cambiar
                        </button>
                    </div>
                }
                else
                {
                    <BuscadorProducto ProductoSeleccionado="SeleccionarProductoParaLote" />
                }
            </div>

            <div class="mb-2">
                <label class="form-label">Proveedor (opcional)</label>
                <InputSelect class="form-select" @bind-Value="proveedorSeleccionado">
                    <option value="0">-- Sin proveedor --</option>
                    @if (proveedores != null)
                    {
                        @foreach (var prov in proveedores)
                        {
                            <option value="@prov.Id">@prov.Nombre</option>
                        }
                    }
                </InputSelect>
            </div>

            <div class="row">
                <div class="col mb-2">
                    <label class="form-label">Fecha de Ingreso</label>
                    <InputDate class="form-control" @bind-Value="loteEditando.FechaIngreso" />
                </div>
                <div class="col mb-2">
                    <label class="form-label">Fecha de Vencimiento</label>
                    <InputDate class="form-control" @bind-Value="loteEditando.FechaVencimiento" />
                </div>
            </div>

            <div class="row">
                <div class="col mb-2">
                    <label class="form-label">Cantidad Inicial</label>
                    <InputNumber class="form-control" @bind-Value="loteEditando.CantidadInicial" />
                </div>
                <div class="col mb-2">
                    <label class="form-label">Cantidad Actual</label>
                    <InputNumber class="form-control" @bind-Value="loteEditando.CantidadActual" />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label">Precio Costo de este Lote</label>
                <InputNumber class="form-control" Value="loteEditando.PrecioCosto" ValueChanged="@((decimal v) => OnPrecioCostoCambiado(v))" ValueExpression="@(() => loteEditando.PrecioCosto)" />
            </div>

            @if (loteEditando.ProductoId > 0)
            {
                <div class="alert alert-info mt-3">
                    <h6>Estado actual del Producto</h6>
                    <ul class="mb-1">
                        <li><strong>Costo de compra actual:</strong> @costoActualProducto.ToString("N2") Bs</li>
                        <li><strong>Precio de venta actual:</strong> @precioVentaActualProducto.ToString("N2") Bs</li>
                    </ul>

                    @if (loteEditando.PrecioCosto > precioVentaActualProducto && loteEditando.PrecioCosto > 0)
                    {
                        <p class="text-danger fw-bold my-2">
                            El costo ingresado (@loteEditando.PrecioCosto.ToString("N2") Bs) supera el precio de venta actual (@precioVentaActualProducto.ToString("N2") Bs).
                        </p>
                    }

                    <div class="mt-2">
                        <label class="form-label fw-bold">Nuevo Precio de Venta Sugerido (30% Margen):</label>
                        <InputNumber class="form-control" @bind-Value="nuevoPrecioVentaSugerido" />
                        <small class="text-muted">Puedes modificar este precio si deseas ajustar el valor comercial de la tienda.</small>
                    </div>
                </div>
            }

            @if (mostrarConfirmacionCosto)
            {
                <div class="alert alert-warning mt-3">
                    <p class="mb-2">
                        El costo actual del producto es <strong>@costoActualProducto.ToString("N2") Bs</strong>
                        y el precio de venta actual es <strong>@precioVentaActualProducto.ToString("N2") Bs</strong>.
                    </p>
                    <p class="mb-2">
                        Este lote se registró con un costo de <strong>@loteEditando.PrecioCosto.ToString("N2") Bs</strong>,
                        con un precio de venta sugerido de <strong>@(nuevoPrecioVentaSugerido?.ToString("N2") ?? "-") Bs</strong>.
                    </p>
                    <p class="mb-2">¿Deseas actualizar el producto con estos nuevos valores?</p>

                    <button type="button" class="btn btn-success btn-sm" @onclick="() => GuardarLoteConfirmado(true)">
                        Sí, actualizar
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => GuardarLoteConfirmado(false)">
                        No, mantener valores actuales
                    </button>
                    <button type="button" class="btn btn-link btn-sm" @onclick="() => mostrarConfirmacionCosto = false">
                        Editar valor
                    </button>
                </div>
            }
            else
            {
                <button type="submit" class="btn btn-success mt-2">Guardar</button>
                <button type="button" class="btn btn-secondary mt-2" @onclick="CerrarFormulario">Cancelar</button>
            }
        </EditForm>
    </div>
}

@code {
    private List<Lote>? lotes;
    private List<Proveedor>? proveedores;
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private Lote loteEditando = new();

    private string? productoSeleccionadoNombre;
    private decimal costoActualProducto = 0;
    private decimal precioVentaActualProducto = 0;
    private decimal? nuevoPrecioVentaSugerido = null;

    private int proveedorSeleccionado
    {
        get => loteEditando.ProveedorId ?? 0;
        set => loteEditando.ProveedorId = value == 0 ? null : value;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        lotes = await LoteSvc.ObtenerTodosAsync();
        proveedores = await ProveedorSvc.ObtenerTodosAsync();
        cargando = false;
    }

    private string ClaseEstado(Lote lote)
    {
        if (lote.Vencido) return "table-danger";
        if (lote.ProximoAVencer) return "table-warning";
        return "";
    }

    private void AbrirFormularioNuevo()
    {
        loteEditando = new Lote
        {
            Activo = true,
            FechaIngreso = DateTime.Now,
            FechaVencimiento = DateTime.Now.AddMonths(6)
        };
        productoSeleccionadoNombre = null;
        costoActualProducto = 0;
        precioVentaActualProducto = 0;
        nuevoPrecioVentaSugerido = null;
        mostrarFormulario = true;
    }

    private async Task SeleccionarProductoParaLote(Producto producto)
    {
        loteEditando.ProductoId = producto.Id;
        productoSeleccionadoNombre = producto.Nombre;

        // Se vuelve a pedir el producto al servidor para no usar una copia
        // en memoria que pudo quedar desactualizada.
        var productoActualizado = await ProductoSvc.ObtenerPorIdAsync(producto.Id);
        costoActualProducto = productoActualizado?.PrecioCosto ?? producto.PrecioCosto;
        precioVentaActualProducto = productoActualizado?.PrecioVenta ?? producto.PrecioVenta;

        RecalcularSugerencia();
    }

    private void QuitarProductoSeleccionado()
    {
        loteEditando.ProductoId = 0;
        productoSeleccionadoNombre = null;
        costoActualProducto = 0;
        precioVentaActualProducto = 0;
        nuevoPrecioVentaSugerido = null;
    }

    private void OnPrecioCostoCambiado(decimal valor)
    {
        loteEditando.PrecioCosto = valor;
        RecalcularSugerencia();
    }

    private void RecalcularSugerencia()
    {
        if (loteEditando.PrecioCosto > 0)
        {
            // Margen de referencia del 30% sobre el costo del nuevo lote.
            // Editable por el administrador antes de guardar.
            nuevoPrecioVentaSugerido = Math.Round(loteEditando.PrecioCosto * 1.30m, 2);
        }
    }

    private async Task AbrirFormularioEditar(Lote lote)
    {
        loteEditando = new Lote
        {
            Id = lote.Id,
            NumeroLote = lote.NumeroLote,
            ProductoId = lote.ProductoId,
            ProveedorId = lote.ProveedorId,
            FechaIngreso = lote.FechaIngreso,
            FechaVencimiento = lote.FechaVencimiento,
            CantidadInicial = lote.CantidadInicial,
            CantidadActual = lote.CantidadActual,
            PrecioCosto = lote.PrecioCosto,
            Activo = lote.Activo
        };

        productoSeleccionadoNombre = lote.Producto?.Nombre;

        var productoActualizado = await ProductoSvc.ObtenerPorIdAsync(lote.ProductoId);
        costoActualProducto = productoActualizado?.PrecioCosto ?? 0;
        precioVentaActualProducto = productoActualizado?.PrecioVenta ?? 0;

        RecalcularSugerencia();
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private bool mostrarConfirmacionCosto = false;

    private async Task GuardarLote()
    {
        if (loteEditando.CantidadActual == 0 && loteEditando.Id == 0)
        {
            loteEditando.CantidadActual = loteEditando.CantidadInicial;
        }

        if (loteEditando.PrecioCosto != costoActualProducto && loteEditando.PrecioCosto > 0)
        {
            mostrarConfirmacionCosto = true;
            return;
        }

        await GuardarLoteConfirmado(actualizarPrecios: true);
    }

    private async Task GuardarLoteConfirmado(bool actualizarPrecios)
    {
        mostrarConfirmacionCosto = false;

        if (loteEditando.Id == 0)
        {
            var request = new LoteCreateRequest
            {
                Lote = loteEditando,
                ActualizarCostoProducto = actualizarPrecios,
                NuevoPrecioVenta = actualizarPrecios ? nuevoPrecioVentaSugerido : null
            };
            await LoteSvc.CrearAsync(request);
        }
        else
        {
            var request = new LoteUpdateRequest
            {
                Lote = loteEditando,
                ActualizarCostoProducto = actualizarPrecios,
                NuevoPrecioVenta = actualizarPrecios ? nuevoPrecioVentaSugerido : null
            };
            await LoteSvc.ActualizarAsync(loteEditando.Id, request);
        }

        mostrarFormulario = false;
        await CargarDatos();
    }

    private async Task EliminarLote(int id)
    {
        await LoteSvc.EliminarAsync(id);
        await CargarDatos();
    }
}