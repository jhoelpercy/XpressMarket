@inject ProductoService ProductoSvc
@inject ISnackbar Snackbar

<MudAutocomplete T="Producto" @ref="_buscador"
                  Value="productoSeleccionado"
                  ValueChanged="OnProductoSelected"
                  SearchFunc="BuscarProductosAsync"
                  ToStringFunc="@(p => p == null ? string.Empty : string.IsNullOrWhiteSpace(p.CodigoBarras) ? p.Nombre : $"{p.CodigoBarras} - {p.Nombre}")"
                  ResetValueOnEmptyText="true"
                  Clearable="true"
                  Variant="Variant.Outlined"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  AdornmentColor="Color.Primary"
                  Placeholder="Buscar producto por nombre, descripción o código..."
                  DebounceInterval="300"
                  FullWidth="true"
                  Dense="true">
    <ItemTemplate>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100 py-1">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body1" Class="fw-bold">@context.Nombre</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode" Size="Size.Small" Style="color: #6c757d;" />
                    <MudText Typo="Typo.caption" Style="color: #6c757d;">
                        @(string.IsNullOrEmpty(context.CodigoBarras) ? "Sin código" : context.CodigoBarras)
                    </MudText>
                </MudStack>
            </MudStack>

            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudText Typo="Typo.body2" Class="fw-bold" Style="color: #6b2181;">
                    Bs. @context.PrecioVenta.ToString("N2")
                </MudText>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.StockActual > 10 ? Color.Success : context.StockActual > 0 ? Color.Warning : Color.Error)"
                         Variant="Variant.Text"
                         Class="ma-0">
                    Stock: @context.StockActual
                </MudChip>
            </MudStack>
        </MudStack>
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter] public EventCallback<Producto> OnProductoAgregado { get; set; }

    private MudAutocomplete<Producto>? _buscador;
    private Producto? productoSeleccionado;
    // La búsqueda se hace en el servidor y devuelve sólo las 20 mejores coincidencias,
    // de modo que el tiempo no depende del tamaño del catálogo.
    private async Task<IEnumerable<Producto>> BuscarProductosAsync(string? valor, CancellationToken token)
    {
        try
        {
            return await ProductoSvc.BuscarAsync(valor, 20, token);
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<Producto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudieron cargar los productos: {ex.Message}", Severity.Error);
            return Enumerable.Empty<Producto>();
        }
    }

    private async Task OnProductoSelected(Producto? producto)
    {
        if (producto == null) return;

        if (producto.StockActual <= 0)
        {
            Snackbar.Add($"'{producto.Nombre}' no tiene stock disponible.", Severity.Warning);
        }
        else
        {
            await OnProductoAgregado.InvokeAsync(producto);
        }

        productoSeleccionado = null;

        // Deja el cuadro de búsqueda vacío para el siguiente producto.
        if (_buscador != null)
            await _buscador.ClearAsync();
    }
}
