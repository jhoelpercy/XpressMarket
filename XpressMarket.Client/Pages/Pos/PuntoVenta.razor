@page "/punto-venta"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Cajero")]
@inject VentaService VentaSvc
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<PageTitle>Punto de Venta - XpressMarket</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 pa-md-6">

    @* ==================== ENCABEZADO ==================== *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6" Wrap="Wrap.Wrap">
        <MudStack Spacing="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="color: #f38218;" />
                <MudText Typo="Typo.overline" Style="color: #6c757d; letter-spacing: 1px;">
                    CAJA / PUNTO DE VENTA
                </MudText>
            </MudStack>
            <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #6b2181;">
                Punto de Venta
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #6c757d;">
                Registra transacciones y emite comprobantes al instante
            </MudText>
        </MudStack>

        <MudPaper Elevation="0" Class="pa-3 rounded-lg"
                  Style="background: linear-gradient(135deg, #6b2181 0%, #8e3aa8 100%);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Style="color: #f38218;" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Style="color: rgba(251,242,219,0.7);">Estado</MudText>
                    <MudText Typo="Typo.body1" Class="fw-bold" Style="color: #fbf2db;">Caja Activa</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudStack>

    @* ==================== GRID PRINCIPAL ==================== *@
    <MudGrid Spacing="4">

        @* -------- COLUMNA IZQUIERDA: Buscador + Carrito -------- *@
        <MudItem xs="12" lg="8">

            @* Buscador destacado *@
            <MudPaper Elevation="1" Class="pa-4 mb-4 rounded-lg">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Style="color: #6b2181;" />
                    <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #6b2181;">
                        Buscar Producto
                    </MudText>
                </MudStack>
                <BuscadorProducto OnProductoAgregado="AgregarAlCarrito" />
            </MudPaper>

            @* Tabla del carrito *@
            <MudPaper Elevation="1" Class="rounded-lg overflow-hidden">

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
                          Class="px-4 py-3"
                          Style="background: #f8f9fa; border-bottom: 1px solid #e9ecef;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Style="color: #6b2181;" />
                        <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #6b2181;">
                            Carrito de Venta
                        </MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small"
                             Style="background-color: #6b2181; color: #fbf2db;"
                             Class="fw-bold">
                        @carrito.Count item(s)
                    </MudChip>
                </MudStack>

                <TablaCarrito Carrito="carrito"
                              OnCantidadModificada="RecalcularTotales"
                              OnEliminarItem="RemoverDelCarrito" />
            </MudPaper>
        </MudItem>

        @* -------- COLUMNA DERECHA: Resumen tipo ticket -------- *@
        <MudItem xs="12" lg="4">
            <ResumenVentaCard SubTotal="subtotal"
                              DescuentoTotal="descuentoTotal"
                              Total="total"
                              OnConfirmarVenta="ProcesarPago"
                              Procesando="procesando"
                              TieneItems="carrito.Any()" />
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<DetalleVenta> carrito = new();
    private decimal subtotal;
    private decimal descuentoTotal;
    private decimal total;
    private bool procesando = false;

    private void AgregarAlCarrito(Producto producto)
    {
        if (producto == null) return;

        var existente = carrito.FirstOrDefault(i => i.ProductoId == producto.Id);
        int cantidadActual = existente?.Cantidad ?? 0;

        // Validación de stock en el cliente
        if (cantidadActual + 1 > producto.StockActual)
        {
            Snackbar.Add($"Stock insuficiente para '{producto.Nombre}'. Disponible: {producto.StockActual}",
                         Severity.Warning);
            return;
        }

        if (existente != null)
        {
            existente.Cantidad++;
        }
        else
        {
            carrito.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                NombreProducto = producto.Nombre,
                PrecioUnitario = producto.PrecioVenta,
                Cantidad = 1,
                Descuento = 0
            });
        }
        RecalcularTotales();
    }

    private void RemoverDelCarrito(DetalleVenta item)
    {
        carrito.Remove(item);
        RecalcularTotales();
    }

    private void RecalcularTotales()
    {
        subtotal = carrito.Sum(i => i.Cantidad * i.PrecioUnitario);
        descuentoTotal = carrito.Sum(i => i.Descuento);
        total = carrito.Sum(i => i.Subtotal);
        StateHasChanged();
    }

    private async Task ProcesarPago()
    {
        if (!carrito.Any()) return;

        procesando = true;
        try
        {
            var nuevaVenta = new Venta
            {
                FechaVenta = DateTime.Now,
                Subtotal = subtotal,
                Descuento = descuentoTotal,
                Total = total,
                Estado = EstadoVenta.Completada,
                UsuarioId = "1",
                NombreUsuario = "Cajero",
                Detalles = carrito,
            };

            var resultado = await VentaSvc.RegistrarVentaAsync(nuevaVenta);

            if (resultado.Exito && resultado.Venta != null)
            {
                carrito.Clear();
                RecalcularTotales();

                Snackbar.Add("Venta registrada correctamente", Severity.Success);
                NavManager.NavigateTo($"/comprobante-venta/{resultado.Venta.Id}");
            }
            else
            {
                Snackbar.Add(resultado.Error ?? "No se pudo registrar la venta",
                             Severity.Error,
                             config => { config.VisibleStateDuration = 6000; });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            procesando = false;
        }
    }
}