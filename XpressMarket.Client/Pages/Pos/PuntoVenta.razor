@page "/punto-venta"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject VentaService VentaSvc
@inject NavigationManager NavManager

<PageTitle>Punto de Venta - XpressMarket</PageTitle>

<div class="pos-container pa-4 pa-md-6">
    <div class="d-flex align-center justify-between mb-4">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold" Style="color: #6b2181;">Punto de Venta</MudText>
            <MudText Typo="Typo.body2" Style="color: #6c757d;">Registra transacciones y emite comprobantes al instante</MudText>
        </div>
        <MudChip T="string" Icon="@Icons.Material.Filled.Storefront" Style="background-color: #6b2181; color: #fbf2db;" Class="fw-bold">
            Caja Activa
        </MudChip>
    </div>

    <MudGrid Spacing="4">
        <MudItem xs="12" lg="8">
            <MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg">
                <BuscadorProducto OnProductoAgregado="AgregarAlCarrito" />
            </MudPaper>

            <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                <TablaCarrito Carrito="carrito"
                              OnCantidadModificada="RecalcularTotales"
                              OnEliminarItem="RemoverDelCarrito" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <ResumenVentaCard SubTotal="subtotal"
                              DescuentoTotal="descuentoTotal"
                              Total="total"
                              OnConfirmarVenta="ProcesarPago"
                              Procesando="procesando"
                              TieneItems="carrito.Any()" />
        </MudItem>
    </MudGrid>
</div>

@code {
    private List<DetalleVenta> carrito = new();
    private decimal subtotal;
    private decimal descuentoTotal;
    private decimal total;
    private bool procesando = false;

    private void AgregarAlCarrito(Producto producto)
    {
        if (producto == null) return;

        var existente = carrito.FirstOrDefault(i => i.ProductoId == producto.Id);
        if (existente != null)
        {
            existente.Cantidad++;
        }
        else
        {
            carrito.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                NombreProducto = producto.Nombre,
                PrecioUnitario = producto.PrecioVenta,
                Cantidad = 1,
                Descuento = 0
            });
        }
        RecalcularTotales();
    }

    private void RemoverDelCarrito(DetalleVenta item)
    {
        carrito.Remove(item);
        RecalcularTotales();
    }

    private void RecalcularTotales()
    {
        subtotal = carrito.Sum(i => i.Cantidad * i.PrecioUnitario);
        descuentoTotal = carrito.Sum(i => i.Descuento);
        total = carrito.Sum(i => i.Subtotal);
        StateHasChanged();
    }

    private async Task ProcesarPago()
    {
        if (!carrito.Any()) return;

        procesando = true;
        try
        {
            var nuevaVenta = new Venta
            {
                FechaVenta = DateTime.Now,
                Subtotal = subtotal,
                Descuento = descuentoTotal,
                Total = total,
                Estado = EstadoVenta.Completada,
                UsuarioId = "1",
                NombreUsuario = "Cajero",
                Detalles = carrito,
            };

            var resultado = await VentaSvc.RegistrarVentaAsync(nuevaVenta);

            if (resultado.Exito && resultado.Venta != null)
            {
                carrito.Clear();
                RecalcularTotales();
                NavManager.NavigateTo($"/comprobante-venta/{resultado.Venta.Id}");
            }
            else
            {
                Console.WriteLine($"Error del servidor: {resultado.Error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al procesar venta: {ex.Message}");
        }
        finally
        {
            procesando = false;
        }
    }
}