<MudTable Items="Carrito" Hover="true" Dense="true" Elevation="0" Class="rounded-lg">
    <HeaderContent>
        <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Producto</MudText></MudTh>
        <MudTh Class="text-right"><MudText Typo="Typo.subtitle2" Class="fw-bold">Precio U.</MudText></MudTh>
        <MudTh Class="text-center"><MudText Typo="Typo.subtitle2" Class="fw-bold">Cantidad</MudText></MudTh>
        <MudTh Class="text-right"><MudText Typo="Typo.subtitle2" Class="fw-bold">Descuento</MudText></MudTh>
        <MudTh Class="text-right"><MudText Typo="Typo.subtitle2" Class="fw-bold">Subtotal</MudText></MudTh>
        <MudTh Class="text-center"></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Producto">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body1" Class="fw-bold">@context.NombreProducto</MudText>
            </MudStack>
        </MudTd>

        <MudTd DataLabel="Precio U." Class="text-right">
            <MudText Typo="Typo.body2" Style="color: #6c757d;">
                @context.PrecioUnitario.ToString("C2")
            </MudText>
        </MudTd>

        <MudTd DataLabel="Cantidad" Class="text-center">
            <MudNumericField Value="context.Cantidad"
                             ValueChanged="@(async (int val) => await CambiarCantidad(context, val))"
                             Min="1"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Style="width: 90px;"
                             Class="mx-auto" />
        </MudTd>

        <MudTd DataLabel="Descuento" Class="text-right">
            <MudText Typo="Typo.body2" Style="color: #dc3545;">
                -@context.Descuento.ToString("C2")
            </MudText>
        </MudTd>

        <MudTd DataLabel="Subtotal" Class="text-right">
            <MudText Typo="Typo.body1" Class="fw-bold" Style="color: #6b2181;">
                @context.Subtotal.ToString("C2")
            </MudText>
        </MudTd>

        <MudTd Class="text-center">
            <MudTooltip Text="Eliminar del carrito">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                               Color="Color.Error"
                               Size="Size.Small"
                               Variant="Variant.Text"
                               OnClick="@(async () => await EliminarItem(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.RemoveShoppingCart"
                     Size="Size.Large"
                     Style="color: #adb5bd;" />
            <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #6c757d;">
                El carrito está vacío
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #adb5bd;">
                Busca productos arriba para comenzar la venta
            </MudText>
        </MudStack>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter] public List<DetalleVenta> Carrito { get; set; } = new();
    [Parameter] public EventCallback OnCantidadModificada { get; set; }
    [Parameter] public EventCallback<DetalleVenta> OnEliminarItem { get; set; }

    private async Task CambiarCantidad(DetalleVenta item, int nuevaCantidad)
    {
        item.Cantidad = nuevaCantidad;
        await OnCantidadModificada.InvokeAsync();
    }

    private async Task EliminarItem(DetalleVenta item)
    {
        await OnEliminarItem.InvokeAsync(item);
    }
}