@page "/punto-venta"
@using Microsoft.AspNetCore.Authorization
@using XpressMarket.Shared.Models
@attribute [Authorize]

@inject VentaService VentaSvc
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@using XpressMarket.Shared.Extensions

<PageTitle>Punto de Venta</PageTitle>

<h3>Punto de Venta</h3>

<BuscadorProducto ProductoSeleccionado="AgregarProductoAlCarrito" />

@if (mensajeError != null)
{
    <div class="alert alert-danger mt-3">@mensajeError</div>
}

@if (ultimaVentaId != null)
{
    <div class="alert alert-success mt-3 d-flex justify-content-between align-items-center">
        <span>Venta N° @ultimaVentaId registrada con éxito.</span>
        <button class="btn btn-sm btn-outline-success" @onclick="DescargarComprobante">
            Descargar Comprobante PDF
        </button>
    </div>
}

@if (carrito.Any())
{
    <table class="table mt-3 align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Precio Unit.</th>
                <th>Cantidad</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in carrito)
            {
                var subtotalItem = (item.Cantidad * item.PrecioUnitario) - item.Descuento;
                <tr>
                    <td>@item.NombreProducto</td>
                    <td>@item.PrecioUnitario.Bs()</td>
                    <td style="width: 120px;">
                        <input type="number" class="form-control form-control-sm" min="1"
                               value="@item.Cantidad"
                               @onchange="(e) => CambiarCantidad(item, e.Value)" />
                    </td>
                    <td>@subtotalItem.Bs()</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => QuitarDelCarrito(item)">
                            Quitar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end mt-3">
        <h4>Total: @TotalCarrito.Bs()</h4>
        <button class="btn btn-success btn-lg" @onclick="ConfirmarVenta" disabled="@procesando">
            @(procesando ? "Procesando..." : "Confirmar Venta")
        </button>
    </div>
}
else
{
    <p class="text-muted mt-3">Busca un producto arriba para agregarlo a la venta.</p>
}

@code {
    private List<DetalleVenta> carrito = new();
    private string? mensajeError;
    private bool procesando = false;
    private int? ultimaVentaId;

    private decimal TotalCarrito => carrito.Sum(i => (i.Cantidad * i.PrecioUnitario) - i.Descuento);

    private void AgregarProductoAlCarrito(Producto producto)
    {
        mensajeError = null;
        ultimaVentaId = null; // Limpiar mensaje de éxito anterior

        var itemExistente = carrito.FirstOrDefault(i => i.ProductoId == producto.Id);

        if (itemExistente != null)
        {
            itemExistente.Cantidad++;
        }
        else
        {
            carrito.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                NombreProducto = producto.Nombre,
                PrecioUnitario = producto.PrecioVenta,
                Cantidad = 1,
                Descuento = 0
            });
        }
    }

    private void CambiarCantidad(DetalleVenta item, object? valor)
    {
        if (int.TryParse(valor?.ToString(), out int nuevaCantidad) && nuevaCantidad > 0)
        {
            item.Cantidad = nuevaCantidad;
        }
    }

    private void QuitarDelCarrito(DetalleVenta item)
    {
        carrito.Remove(item);
    }

    private async Task ConfirmarVenta()
    {
        if (!carrito.Any()) return;

        mensajeError = null;
        procesando = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var usuarioActual = authState.User;

            var venta = new Venta
            {
                NombreUsuario = usuarioActual.Identity?.Name ?? "Desconocido",
                UsuarioId = usuarioActual.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0",
                Detalles = carrito
            };

            var (exito, error, ventaCreada) = await VentaSvc.RegistrarVentaAsync(venta);

            if (exito && ventaCreada != null)
            {
                ultimaVentaId = ventaCreada.Id;
                carrito.Clear(); // Vaciar carrito tras registro correcto
            }
            else
            {
                mensajeError = error ?? "Ocurrió un error al procesar la venta.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task DescargarComprobante()
    {
        if (ultimaVentaId == null) return;

        try
        {
            var bytes = await VentaSvc.ObtenerComprobantePdfAsync(ultimaVentaId.Value);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("descargarArchivo", $"Comprobante_Venta_{ultimaVentaId}.pdf", base64);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al descargar el comprobante: {ex.Message}";
        }
    }
}