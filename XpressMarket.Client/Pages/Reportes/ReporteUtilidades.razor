@page "/reporte-utilidades"
@using Microsoft.AspNetCore.Authorization
@using XpressMarket.Shared.Models
@using XpressMarket.Shared.Extensions
@using MudBlazor
@attribute [Authorize(Roles = "Administrador")]
@inject VentaService VentaSvc
@inject ReporteService ReporteSvc
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>XpressMarket - Reporte de Utilidades</PageTitle>

<div class="pa-3 pa-sm-4 pa-md-6">

    @* ==================== BANNER ==================== *@
    <MudPaper Elevation="0" Class="pa-4 pa-sm-5 pa-md-6 mb-4 mb-md-6 rounded-xl"
              Style="background: linear-gradient(135deg, #4a1458 0%, #6b2181 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.1);">
        <div class="d-flex flex-column flex-md-row justify-between align-start align-md-center gap-3">
            <div>
                <div class="d-flex align-center gap-2 mb-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Style="background-color: rgba(243, 130, 24, 0.2); color: #f38218;"
                             Class="fw-bold">
                        Análisis Financiero
                    </MudChip>
                </div>
                <MudText Typo="Typo.h4" Class="fw-bold mb-1"
                         Style="color: #ffffff; text-shadow: 0px 2px 4px rgba(0,0,0,0.2); font-size: clamp(1.4rem, 4vw, 2.125rem);">
                    Reporte de Utilidades
                </MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85);">
                    Control de ingresos, costos totales y márgenes de utilidad por venta y período.
                </MudText>
            </div>
            <div class="d-none d-md-block">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="font-size: 4.5rem; color: rgba(255,255,255,0.15);" />
            </div>
        </div>
    </MudPaper>

    @* ==================== VISTA POR PERÍODO ==================== *@
    <MudPaper Elevation="2" Class="pa-3 pa-sm-4 pa-md-5 mb-4 mb-md-6 rounded-xl">
        <div class="d-flex flex-column flex-sm-row justify-between align-start align-sm-center gap-3 mb-4">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart" Style="color: #6b2181;" Class="mr-2" />
                <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">Vista por Período</MudText>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="ExportarPeriodoPdf">
                    PDF
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.TableChart"
                           OnClick="ExportarPeriodoExcel">
                    Excel
                </MudButton>
            </div>
        </div>

        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Label="Agrupar por" @bind-Value="agrupacionSeleccionada"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("dia")">Día</MudSelectItem>
                    <MudSelectItem T="string" Value="@("semana")">Semana</MudSelectItem>
                    <MudSelectItem T="string" Value="@("mes")">Mes</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="Desde" @bind-Date="periodoDesde"
                               Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="Hasta" @bind-Date="periodoHasta"
                               Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudButton Variant="Variant.Filled"
                           Style="background-color: #6b2181; color: #ffffff;"
                           FullWidth="true" OnClick="CargarPeriodo">
                    Consultar
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (cargandoPeriodo)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (resumenPeriodo.Any())
        {
            <div style="position: relative; width: 100%; height: clamp(220px, 40vw, 320px);" class="mb-4">
                <canvas id="graficoUtilidadPeriodo"></canvas>
            </div>
            <MudTable Items="@resumenPeriodo" Dense="true" Hover="true" Elevation="0" Class="rounded-lg"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Período</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Ventas</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Costo</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Utilidad</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Período">@context.Etiqueta</MudTd>
                    <MudTd DataLabel="Ventas" Class="text-end">@context.TotalVentas.Bs()</MudTd>
                    <MudTd DataLabel="Costo" Class="text-end">@context.CostoTotal.Bs()</MudTd>
                    <MudTd DataLabel="Utilidad" Class="text-end">
                        <MudText Typo="Typo.body2" Class="fw-bold"
                                 Style="@(context.Utilidad >= 0 ? "color:#2e7d32;" : "color:#d32f2f;")">
                            @context.Utilidad.Bs()
                        </MudText>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="text-muted italic pa-4">
                No hay datos en este período.
            </MudText>
        }
    </MudPaper>

    @* ==================== DETALLE POR VENTA ==================== *@
    <MudPaper Elevation="2" Class="pa-3 pa-sm-4 pa-md-5 rounded-xl">
        <div class="d-flex flex-column flex-sm-row justify-between align-start align-sm-center gap-3 mb-4">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Style="color: #f38218;" Class="mr-2" />
                <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #2b2b2b;">
                    Detalle de Ventas y Utilidades
                </MudText>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="ExportarDetallePdf">
                    PDF
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.TableChart"
                           OnClick="ExportarDetalleExcel">
                    Excel
                </MudButton>
            </div>
        </div>

        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker Label="Desde" @bind-Date="fechaDesde"
                               Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker Label="Hasta" @bind-Date="fechaHasta"
                               Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           FullWidth="true" OnClick="Filtrar">
                    Filtrar Detalle
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (cargando)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (!ventas.Any())
        {
            <MudText Typo="Typo.body2" Class="text-muted italic pa-4">
                No hay ventas registradas en este período.
            </MudText>
        }
        else
        {
            <MudTable Items="@ventas" Dense="true" Hover="true" Elevation="0" Class="rounded-lg"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">N° Venta</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Fecha</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2" Class="fw-bold">Cajero</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Total Venta</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Costo Total</MudText></MudTh>
                    <MudTh Class="text-end"><MudText Typo="Typo.subtitle2" Class="fw-bold">Utilidad</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="N° Venta">
                        <MudText Typo="Typo.body2" Class="fw-bold" Style="color:#6b2181;">@context.VentaId</MudText>
                    </MudTd>
                    <MudTd DataLabel="Fecha">@context.FechaVenta.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Cajero">@context.NombreUsuario</MudTd>
                    <MudTd DataLabel="Total Venta" Class="text-end">@context.TotalVenta.Bs()</MudTd>
                    <MudTd DataLabel="Costo Total" Class="text-end">@context.CostoTotal.Bs()</MudTd>
                    <MudTd DataLabel="Utilidad" Class="text-end">
                        <MudText Typo="Typo.body2" Class="fw-bold"
                                 Style="@(context.Utilidad >= 0 ? "color:#2e7d32;" : "color:#d32f2f;")">
                            @context.Utilidad.Bs()
                        </MudText>
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd colspan="3" Class="text-end"><strong>Totales:</strong></MudTd>
                    <MudTd Class="text-end"><strong>@ventas.Sum(v => v.TotalVenta).Bs()</strong></MudTd>
                    <MudTd Class="text-end"><strong>@ventas.Sum(v => v.CostoTotal).Bs()</strong></MudTd>
                    <MudTd Class="text-end">
                        <strong style="@(ventas.Sum(v => v.Utilidad) >= 0 ? "color:#2e7d32;" : "color:#d32f2f;")">
                            @ventas.Sum(v => v.Utilidad).Bs()
                        </strong>
                    </MudTd>
                </FooterContent>
            </MudTable>
        }
    </MudPaper>
</div>

@code {
    private List<ResumenUtilidad> ventas = new();
    private bool cargando = true;
    private bool cargandoPeriodo = true;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string agrupacionSeleccionada = "dia";
    private DateTime? periodoDesde = DateTime.Now.AddDays(-7);
    private DateTime? periodoHasta = DateTime.Now;
    private List<PeriodoResumen> resumenPeriodo = new();
    private bool graficoPendiente = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarPeriodo();
        await Filtrar();
    }

    private async Task CargarPeriodo()
    {
        if (!periodoDesde.HasValue || !periodoHasta.HasValue) return;

        cargandoPeriodo = true;
        try
        {
            resumenPeriodo = await VentaSvc.ObtenerReportePeriodoAsync(
                periodoDesde.Value, periodoHasta.Value, agrupacionSeleccionada);
            graficoPendiente = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar período: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargandoPeriodo = false;
        }
    }

    private async Task Filtrar()
    {
        cargando = true;
        try
        {
            ventas = await VentaSvc.ObtenerReporteUtilidadesAsync(fechaDesde, fechaHasta);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al filtrar: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (graficoPendiente && resumenPeriodo.Any())
        {
            graficoPendiente = false;
            await Task.Delay(50);

            try
            {
                var labels = resumenPeriodo.Select(p => p.Etiqueta).ToArray();
                var datos = resumenPeriodo.Select(p => p.Utilidad).ToArray();
                await JS.InvokeVoidAsync("renderizarGraficoLinea", "graficoUtilidadPeriodo",
                    labels, datos, "#6b2181", "rgba(107,33,129,0.12)", "Utilidad (Bs)");
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al renderizar gráfico: {ex.Message}", Severity.Warning);
            }
        }
    }

    // ==================== EXPORTACIONES ====================

    private async Task ExportarPeriodoPdf()
    {
        var bytes = await ReporteSvc.ObtenerUtilidadesPdfAsync(periodoDesde, periodoHasta);
        if (bytes == null)
        {
            Snackbar.Add("No se pudo generar el PDF", Severity.Error);
            return;
        }
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("abrirPdfDesdeBase64", base64, $"Reporte_Utilidades_{DateTime.Now:yyyyMMdd}.pdf");
    }

    private async Task ExportarPeriodoExcel()
    {
        var bytes = await ReporteSvc.ObtenerUtilidadesExcelAsync(periodoDesde, periodoHasta);
        if (bytes == null)
        {
            Snackbar.Add("No se pudo generar el Excel", Severity.Error);
            return;
        }
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivoExcel", $"Reporte_Utilidades_{DateTime.Now:yyyyMMdd}.xlsx", base64);
        Snackbar.Add("Excel descargado", Severity.Success);
    }

    private async Task ExportarDetallePdf()
    {
        var bytes = await ReporteSvc.ObtenerUtilidadesPdfAsync(fechaDesde, fechaHasta);
        if (bytes == null)
        {
            Snackbar.Add("No se pudo generar el PDF", Severity.Error);
            return;
        }
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("abrirPdfDesdeBase64", base64, $"Reporte_Utilidades_{DateTime.Now:yyyyMMdd}.pdf");
    }

    private async Task ExportarDetalleExcel()
    {
        var bytes = await ReporteSvc.ObtenerUtilidadesExcelAsync(fechaDesde, fechaHasta);
        if (bytes == null)
        {
            Snackbar.Add("No se pudo generar el Excel", Severity.Error);
            return;
        }
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivoExcel", $"Reporte_Utilidades_{DateTime.Now:yyyyMMdd}.xlsx", base64);
        Snackbar.Add("Excel descargado", Severity.Success);
    }
}