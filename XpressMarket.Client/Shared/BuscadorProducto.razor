@inject ProductoService ProductoSvc
@using XpressMarket.Shared.Models
@using XpressMarket.Shared.Extensions

<MudAutocomplete T="Producto"
                 Placeholder="Buscar producto por nombre o código..."
                 SearchFunc="BuscarProductos"
                 ToStringFunc="@(p => p != null ? p.Nombre : string.Empty)"
                 ValueChanged="SeleccionarProducto"
                 ResetValueOnSelected="true"
                 MinCharacters="1"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 Variant="Variant.Outlined"
                 Dense="true">
    <ItemTemplate Context="prod">
        <div class="pa-1">
            <MudText Typo="Typo.body2" Class="fw-bold">@prod.Nombre</MudText>
            <MudText Typo="Typo.caption" Style="color: #6c757d;">
                Precio: Bs. @prod.PrecioVenta.ToString("F2") | Stock: @prod.StockActual
            </MudText>
        </div>
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter]
    public EventCallback<Producto> ProductoSeleccionado { get; set; }

    private List<Producto> todosLosProductos = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var productos = await ProductoSvc.ObtenerTodosAsync();
            todosLosProductos = productos ?? new List<Producto>();
        }
        catch
        {
            todosLosProductos = new List<Producto>();
        }
    }

    private Task<IEnumerable<Producto>> BuscarProductos(string texto, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return Task.FromResult<IEnumerable<Producto>>(todosLosProductos.Take(10));
        }

        var resultado = todosLosProductos
            .Where(p => p != null && 
                       ((!string.IsNullOrEmpty(p.Nombre) && p.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(p.CodigoBarras) && p.CodigoBarras.Contains(texto, StringComparison.OrdinalIgnoreCase))))
            .Take(10);

        return Task.FromResult<IEnumerable<Producto>>(resultado);
    }

    private async Task SeleccionarProducto(Producto producto)
    {
        if (producto != null)
        {
            await ProductoSeleccionado.InvokeAsync(producto);
        }
    }
}