@using XpressMarket.Shared.Models
@inject CategoriaService CategoriaSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #6b2181;">
            <MudIcon Icon="@(EsNuevo ? Icons.Material.Filled.AddCircle : Icons.Material.Filled.Edit)" Class="mr-2" />
            @(EsNuevo ? "Nueva Categoría" : "Editar Categoría")
        </MudText>
    </TitleContent>

    <DialogContent>
        <EditForm Model="Categoria" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <MudTextField Label="Nombre"
                          @bind-Value="Categoria.Nombre"
                          For="@(() => Categoria.Nombre)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            <MudTextField Label="Descripción"
                          @bind-Value="Categoria.Descripcion"
                          For="@(() => Categoria.Descripcion)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Margin="Margin.Dense"
                          Class="mb-3" />
        </EditForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled"
                   Style="background-color: #6b2181; color: #ffffff;"
                   Disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Categoria Categoria { get; set; } = new();
    [Parameter] public bool EsNuevo { get; set; }

    private bool _guardando = false;

    private void Cancelar()
    {
        MudDialog.Cancel();
    }

    private async Task Guardar()
    {
        _guardando = true;
        try
        {
            if (EsNuevo)
            {
                var creada = await CategoriaSvc.CrearAsync(Categoria);
                if (creada == null)
                {
                    Snackbar.Add("No se pudo crear la categoría", Severity.Error);
                    return;
                }
                Snackbar.Add("Categoría creada con éxito", Severity.Success);
            }
            else
            {
                var actualizada = await CategoriaSvc.ActualizarAsync(Categoria.Id, Categoria);
                if (!actualizada)
                {
                    Snackbar.Add("No se pudo actualizar la categoría", Severity.Error);
                    return;
                }
                Snackbar.Add("Categoría actualizada con éxito", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}