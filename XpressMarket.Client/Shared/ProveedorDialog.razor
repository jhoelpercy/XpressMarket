@using XpressMarket.Shared.Models
@inject ProveedorService ProveedorSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #6b2181;">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
            @(EsNuevo ? "Nuevo Proveedor" : "Editar Proveedor")
        </MudText>
    </TitleContent>

    <DialogContent>
        <EditForm Model="Proveedor" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger p-2 small mb-3" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nombre de la Empresa"
                                  @bind-Value="Proveedor.Nombre"
                                  For="@(() => Proveedor.Nombre)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-3" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Persona de Contacto"
                                  @bind-Value="Proveedor.Contacto"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-3" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Teléfono"
                                  @bind-Value="Proveedor.Telefono"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-3" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="Correo Electrónico"
                                  @bind-Value="Proveedor.Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-3" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Dirección / Ubicación"
                                  @bind-Value="Proveedor.Direccion"
                                  Lines="2"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled"
                   Style="background-color: #6b2181; color: #ffffff;"
                   Disabled="@_guardando">
            @(_guardando ? "Guardando..." : "Guardar Proveedor")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Proveedor Proveedor { get; set; } = new();
    [Parameter] public bool EsNuevo { get; set; }

    private bool _guardando = false;

    private void Cancelar()
    {
        MudDialog.Cancel();
    }

    private async Task Guardar()
    {
        _guardando = true;
        try
        {
            if (EsNuevo)
            {
                var creado = await ProveedorSvc.CrearAsync(Proveedor);
                if (creado == null)
                {
                    Snackbar.Add("No se pudo crear el proveedor", Severity.Error);
                    return;
                }
                Snackbar.Add("Proveedor creado", Severity.Success);
            }
            else
            {
                var actualizado = await ProveedorSvc.ActualizarAsync(Proveedor.Id, Proveedor);
                if (!actualizado)
                {
                    Snackbar.Add("No se pudo actualizar el proveedor", Severity.Error);
                    return;
                }
                Snackbar.Add("Proveedor actualizado", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}