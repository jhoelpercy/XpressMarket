@using XpressMarket.Shared.Models
@inject UsuarioService UsuarioSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="fw-bold" Style="color: #6b2181;">
            <MudIcon Icon="@(EsNuevo ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.ManageAccounts)" Class="mr-2" />
            @(EsNuevo ? "Nuevo Usuario" : $"Editar Usuario: {NombreUsuarioMostrar}")
        </MudText>
    </TitleContent>

    <DialogContent>
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger p-2 small mb-3" />

            @if (EsNuevo)
            {
                <MudTextField Label="Nombre Completo"
                              @bind-Value="Modelo.NombreCompleto"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3" />

                <MudTextField Label="Nombre de Usuario"
                              @bind-Value="Modelo.NombreUsuario"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3" />

                <MudTextField Label="Contraseña"
                              @bind-Value="Modelo.Contrasena"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3" />
            }
            else
            {
                @if (EsSuperAdmin)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Cuenta de respaldo del sistema: no puede desactivarse ni cambiar de rol. Solo puedes cambiar su contraseña.
                    </MudAlert>
                }

                <MudTextField Label="Nombre de Usuario"
                              Value="@NombreUsuarioMostrar"
                              ReadOnly="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3" />

                <MudSwitch T="bool"
                           @bind-Value="ModeloActivo"
                           Label="Usuario Activo"
                           Color="Color.Primary"
                           Disabled="@EsSuperAdmin"
                           Class="mb-3" />

                <MudTextField Label="Nueva Contraseña"
                              @bind-Value="ModeloNuevaContrasena"
                              InputType="InputType.Password"
                              HelperText="Dejar en blanco para no cambiarla"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3" />
            }

            <MudSelect T="string" Label="Rol"
                       @bind-Value="RolSeleccionado"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="@(!EsNuevo && EsSuperAdmin)"
                       Class="mb-3">
                <MudSelectItem T="string" Value="@("Cajero")">Cajero</MudSelectItem>
                <MudSelectItem T="string" Value="@("Administrador")">Administrador</MudSelectItem>
            </MudSelect>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Outlined" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled"
                   Style="background-color: #6b2181; color: #ffffff;"
                   Disabled="@_guardando">
            @(_guardando ? "Guardando..." : (EsNuevo ? "Crear Usuario" : "Guardar Cambios"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public bool EsNuevo { get; set; }
    [Parameter] public int UsuarioId { get; set; }

    private UsuarioCreateRequest Modelo = new() { Rol = "Cajero" };
    private EditContext _editContext = default!;
    private string NombreUsuarioMostrar = "";
    private string RolSeleccionado = "Cajero";
    private bool ModeloActivo = true;
    private bool EsSuperAdmin;
    private string? ModeloNuevaContrasena;
    private bool _guardando = false;

    protected override void OnInitialized()
    {
        // Al editar no se valida el modelo de creación: sus campos no están en pantalla.
        _editContext = new EditContext(EsNuevo ? Modelo : new object());
    }

    protected override async Task OnInitializedAsync()
    {
        if (!EsNuevo && UsuarioId > 0)
        {
            var usuarios = await UsuarioSvc.ObtenerTodosAsync();
            var u = usuarios.FirstOrDefault(x => x.Id == UsuarioId);
            if (u != null)
            {
                NombreUsuarioMostrar = u.NombreUsuario;
                RolSeleccionado = u.Rol;
                ModeloActivo = u.Activo;
                EsSuperAdmin = u.EsSuperAdmin;
            }
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        if (EsNuevo)
        {
            Modelo.Rol = RolSeleccionado;
            if (!_editContext.Validate())
                return;
        }

        _guardando = true;
        try
        {
            if (EsNuevo)
            {
                var (exito, error) = await UsuarioSvc.CrearAsync(Modelo);
                if (!exito)
                {
                    Snackbar.Add(error ?? "No se pudo crear el usuario", Severity.Error);
                    return;
                }
                Snackbar.Add("Usuario creado correctamente", Severity.Success);
            }
            else
            {
                var request = new UsuarioUpdateRequest
                {
                    Rol = RolSeleccionado,
                    Activo = ModeloActivo,
                    NuevaContrasena = string.IsNullOrWhiteSpace(ModeloNuevaContrasena) ? null : ModeloNuevaContrasena
                };

                var (exito, error) = await UsuarioSvc.ActualizarAsync(UsuarioId, request);
                if (!exito)
                {
                    Snackbar.Add(error ?? "No se pudo actualizar", Severity.Error);
                    return;
                }
                Snackbar.Add("Usuario actualizado", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}